# ============================================================================
# CI/CD & AUTOMATION CONFIGURATION
# ============================================================================
# This file contains environment variables that control non-interactive script
# behavior for CI/CD pipelines, Docker automation, and headless environments.
#
# For local development: copy this to .env.config (gitignored) and uncomment
# the variables you need.
# ============================================================================

# --- Schema Generation ---
# Skip interactive prompts during schema generation
# SCHEMA_AUTO_CONFIRM=yes
# DEPLOYMENT_COUNTRY=PH  # Options: PH (Philippines), SG (Singapore), US (United States)

# --- Database Seeding ---
# Skip confirmation prompt when running seed script
# SEED_AUTO_CONFIRM=yes
# SEED_FOLDER=examples  # Target data folder (default: examples)

# --- Database Reset ---
# Skip confirmation prompt when running reset script (DANGEROUS!)
# RESET_AUTO_CONFIRM=yes

# --- Universal Auto-Confirm ---
# Set this to skip ALL confirmation prompts (use with extreme caution)
# AUTO_CONFIRM=yes
