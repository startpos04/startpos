# =============================================================================
# CI/AUTOMATION CONFIG — web/ monorepo root
# Copy to .env.config (gitignored) and uncomment the values you need.
# These control non-interactive behavior for scripts and Docker automation.
# They are NOT injected into the app — only read by tsx scripts directly.
# =============================================================================

# --- Schema Generation (prisma:generate) ---
# Skip the interactive country/confirmation prompts
# SCHEMA_AUTO_CONFIRM=yes
# DEPLOYMENT_COUNTRY=PH   # Options: PH (Philippines), SG (Singapore), US (United States)

# --- Database Seeding (seed) ---
# Skip confirmation prompt when running seed script
# SEED_AUTO_CONFIRM=yes
# SEED_FOLDER=examples    # Target data folder (default: examples)

# --- Database Reset (reset) ---
# Skip confirmation prompt when running reset script (DANGEROUS in production!)
# RESET_AUTO_CONFIRM=yes

# --- Universal ---
# Skips ALL confirmation prompts — use with extreme caution
# AUTO_CONFIRM=yes
