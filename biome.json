{
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "!!**/node_modules",
      "!!**/.output",
      "!!**/dist",
      "!!**/prisma/generated",
      "!!**/public",
      "!!**/coverage",
      "!!**/e2e-results",
      "!!**/playwright-report",
      "!!**/src/routeTree.gen.ts",
      "!!**/*.test.*",
      "!!**/*.spec.*",
      "!!**/__tests__"
    ]
  },
  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "lineWidth": 160,
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteProperties": "asNeeded",
      "attributePosition": "auto"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnusedImports": "error", "useExhaustiveDependencies": "warn", "useHookAtTopLevel": "error", "noChildrenProp": "off" },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "warn",
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160,
    "attributePosition": "auto",
    "lineEnding": "lf"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "natural"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/styles.css"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ]
}
