{
  "name": "startPOS",
  "private": true,
  "scripts": {
    "env:generate": "tsx scripts/generate-env.ts",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter @startpos/web",
    "build": "turbo build",
    "build:web": "turbo build --filter @startpos/web",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "format": "biome format --write",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "type-check": "turbo type-check",
    "generate": "turbo generate",
    "start": "turbo start",
    "coverage": "turbo coverage",
    "coverage:integration": "turbo coverage:integration",
    "validate": "turbo validate",
    "docker:web": "docker compose --env-file apps/web/.env up --build --watch",
    "docker:down": "docker compose --env-file apps/web/.env down",
    "docker:exec": "docker compose --env-file apps/web/.env exec -it app",
    "stripe:setup": "docker compose --env-file apps/web/.env --profile stripe up --build stripe-setup",
    "stripe:webhook": "docker compose --env-file apps/web/.env --profile stripe up --build stripe-webhook",
    "stripe:start": "docker compose --env-file apps/web/.env --profile stripe up --build stripe-setup stripe-webhook",
    "stripe:down": "docker compose --env-file apps/web/.env --profile stripe stop stripe-setup stripe-webhook"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "cspell": "^10.0.0",
    "lefthook": "^2.1.6",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.0.0"
}
