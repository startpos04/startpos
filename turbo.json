{
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["prisma/**", "../../packages/platform/prisma/**"],
      "outputs": ["prisma/generated/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "__tests__/unit/**"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", "__tests__/integration/**"],
      "outputs": ["coverage/**"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "coverage": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    "coverage:integration": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    "validate": {
      "dependsOn": ["generate", "type-check"],
      "inputs": ["$TURBO_DEFAULT$"]
    }
  }
}
