# ─── DOCKER DEFAULTS (committed, shared) ────────────────────────────────────
# These values are used when running via `pnpm docker:dev`.
# For local development, create a .env.local file (gitignored) that overrides
# only the values below that differ for your machine. See .env.local.example.

BUILD_ID=
CONSOLE_LOG=true

# --- App ---
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3200
NODE_ENV=development
DOCKER_DEV=true

CANONICAL_URL=http://localhost:3200
BETTER_AUTH_URL=http://localhost:3200
BETTER_AUTH_INTERNAL_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=change-me

LOCAL_DB_NAME=my_app_storage

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=start-pos

# --- CI/Automation Config ---
# For non-interactive script behavior (CI/CD, Docker), see .env.config.example
# Create .env.config (gitignored) with SCHEMA_AUTO_CONFIRM, SEED_AUTO_CONFIRM, etc.

# --- OAuth (Phase A — Registration & Onboarding) ---
# Leave blank to disable that provider's button on the /register page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Feature Flags ---
# Set to false to skip email OTP verification during registration.
# Useful when Resend is not yet configured or email delivery is unreliable.
# When false: the OTP step is skipped entirely and users register without email verification.
# Re-enable before going to production with real users.
ENABLE_EMAIL_VERIFICATION=true

# Get your key from https://resend.com — create a free account, add a domain or use
# the shared test domain (onboarding@resend.dev) for development.
RESEND_API_KEY=
# The "from" address shown in emails. Must be a verified sender in Resend.
# Defaults to noreply@start-pos.app if unset.
EMAIL_FROM=

# --- Stripe (Phase F — Billing & Subscriptions) ---
# Required for subscription creation, credit purchases, and webhook processing.
# Use sk_test_* keys and test-mode Price IDs while developing.
# Leave blank to disable Stripe-dependent features.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Plan Price IDs — one per active subscription plan (name-matched at runtime).
# Key format: STRIPE_PLAN_<PLAN_NAME_UPPER>_PRICE_ID
STRIPE_PLAN_STARTER_PRICE_ID=
STRIPE_PLAN_GROWTH_PRICE_ID=
STRIPE_PLAN_PREMIUM_PRICE_ID=
STRIPE_PLAN_TRIAL_PRICE_ID=

# Annual plan Price IDs — required when billingInterval='annual' is selected.
# Key format: STRIPE_PLAN_<PLAN_NAME_UPPER>_ANNUAL_PRICE_ID
# Create a one-time or annual recurring price in Stripe Dashboard for each plan.
STRIPE_PLAN_STARTER_ANNUAL_PRICE_ID=
STRIPE_PLAN_GROWTH_ANNUAL_PRICE_ID=
STRIPE_PLAN_PREMIUM_ANNUAL_PRICE_ID=

# Credit package Price IDs — one per package size in purchase-credit-package.ts
STRIPE_CREDIT_PKG_10_PRICE_ID=
STRIPE_CREDIT_PKG_50_PRICE_ID=
STRIPE_CREDIT_PKG_100_PRICE_ID=

# TX top-up addon Price IDs — one per package size in purchase-tx-addon.ts
STRIPE_TX_ADDON_500_PRICE_ID=
STRIPE_TX_ADDON_1000_PRICE_ID=
STRIPE_TX_ADDON_5000_PRICE_ID=

# Monthly recurring addon Price IDs — one per addon type in purchase-addon-subscription.ts
STRIPE_ADDON_ANALYTICS_PRICE_ID=
STRIPE_ADDON_API_PRICE_ID=
STRIPE_ADDON_BRANCH_PRICE_ID=
STRIPE_ADDON_EMPLOYEE_PRICE_ID=
STRIPE_ADDON_TX_RECURRING_500_PRICE_ID=
STRIPE_ADDON_TX_RECURRING_1000_PRICE_ID=
STRIPE_ADDON_TX_RECURRING_5000_PRICE_ID=

# --- Cron (Background Jobs) ---
# A random secret used to authenticate requests to /api/cron/daily.
# Generate with: openssl rand -hex 32
# On Vercel: add this to project environment variables and reference it in
# vercel.json under crons[].headers.Authorization as "Bearer $CRON_SECRET".
# Leave blank in local dev — the endpoint will return 500 when unset so it
# cannot be accidentally triggered from the public internet.
CRON_SECRET=
