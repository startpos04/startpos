# ─── DOCKER DEFAULTS (committed, shared) ────────────────────────────────────
# These values are used when running via `pnpm docker:dev`.
# For local development, create a .env.local file (gitignored) that overrides
# only the values below that differ for your machine. See .env.local.example.

# --- App ---
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3200
NODE_ENV=development
DOCKER_DEV=true

CANONICAL_URL=http://localhost:3200
BETTER_AUTH_URL=http://localhost:3200
BETTER_AUTH_INTERNAL_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=change-me

LOCAL_DB_NAME=my_app_storage

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=start-pos

# Optional non-interactive seed/reset:
# SEED_AUTO_CONFIRM=yes
# SEED_FOLDER=examples
# RESET_AUTO_CONFIRM=yes

# --- OAuth (Phase A — Registration & Onboarding) ---
# Leave blank to disable that provider's button on the /register page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
