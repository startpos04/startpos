{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "source.fixAll.biome": "explicit"
  },
  // Ensure Biome handles these languages
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  // Keep your other settings
  "cSpell.words": [
    "asku",
    "autoincrement",
    "biomejs",
    "bunx",
    "cachier",
    "CHED",
    "CHKN",
    "cuid",
    "datamodel",
    "dexie",
    "DMMF",
    "dpage",
    "Financials",
    "ilike",
    "lefthook",
    "mfeat",
    "neverthrow",
    "OPFS",
    "papaparse",
    "paralleldrive",
    "Reqs",
    "serwist",
    "Skus",
    "Syncable",
    "TOMA",
    "Uncapitalize",
    "Upsell",
    "Vatable",
    "WASQ"
  ],
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
    "editor.formatOnSave": true
  }
}
