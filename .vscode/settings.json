{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.organizeImports.biome": "explicit",
    "source.fixAll.biome": "explicit"
  },
  // Ensure Biome handles these languages
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  // Keep your other settings
  "cSpell.words": [
    "acra",
    "asku",
    "autoincrement",
    "behaviour",
    "biomejs",
    "bunx",
    "cachier",
    "CHCKN",
    "CHED",
    "CHKN",
    "cmdk",
    "COEP",
    "cuid",
    "datamodel",
    "defence",
    "Dela",
    "dexie",
    "DMMF",
    "dockable",
    "dpage",
    "DSCRT",
    "entr",
    "EOPT",
    "EXPIRABLE",
    "Financials",
    "gcash",
    "halohalo",
    "ilike",
    "lefthook",
    "lifecycles",
    "mfeat",
    "milktea",
    "navigations",
    "neverthrow",
    "NIRC",
    "normalised",
    "nosniff",
    "OPFS",
    "paginable",
    "papaparse",
    "paralleldrive",
    "PAYMONGO",
    "reactivatable",
    "refetches",
    "Reqs",
    "Resto",
    "serwist",
    "sisig",
    "Skus",
    "startpos",
    "Syncable",
    "TOMA",
    "TOPUP",
    "Uncapitalize",
    "UNCOLLECTIBLE",
    "unconfigured",
    "undercount",
    "unnotified",
    "unparse",
    "Unreviewed",
    "unsub",
    "Upsell",
    "upselling",
    "upserts",
    "Vatable",
    "vitejs",
    "WASQ",
    "whsec",
    "XENDIT"
  ],
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
    "editor.formatOnSave": true
  },
  "search.exclude": {
    "**/__tests__/**": true,
    "**/prisma/**": true
  }
}
