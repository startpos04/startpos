# ─── LOCAL DEV OVERRIDES ─────────────────────────────────────────────────────
# Copy this file to .env.local (it is gitignored).
# Only the values that differ from Docker defaults need to be here.
#
# For a second project running on port 3200:
#   PUBLIC_PORT=3200
#   CANONICAL_URL=http://localhost:3200
#   BETTER_AUTH_URL=http://localhost:3200

DOCKER_DEV=false
PUBLIC_PORT=3000
CANONICAL_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_INTERNAL_URL=http://localhost:3000
POSTGRES_HOST=localhost
# Use 5432 for a native local Postgres install.
# Use 5434 if you're connecting to the Docker DB from the host machine.
POSTGRES_HOST_PORT=5432

# --- Email (OTP verification) ---
# Optional for local dev — if unset, OTP codes will be logged to the server console by Resend (test mode).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com
