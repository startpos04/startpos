# =============================================================================
# SHARED LOCAL OVERRIDES TEMPLATE — web/ monorepo root
# Copy to .env.local (gitignored) and adjust for your local setup.
# These override web/.env for local dev (i.e. when NOT running inside Docker).
# =============================================================================

# --- Database ---
# Use localhost when connecting to the Docker DB from your host machine.
# Use 'db' when running inside Docker (that's already the default in web/.env).
POSTGRES_HOST=localhost

# --- apps/web ---
# Override Docker-specific defaults for local Vite dev server
DOCKER_DEV=false
PUBLIC_PORT=3200
CANONICAL_URL=http://localhost:3200
BETTER_AUTH_URL=http://localhost:3200
BETTER_AUTH_INTERNAL_URL=http://localhost:3000
