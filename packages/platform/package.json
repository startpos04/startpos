{
  "name": "@startpos/platform",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "pnpm exec prisma generate --config prisma.config.ts && tsx prisma/sync-meta.ts",
    "prisma:generate": "tsx --env-file=../../.env.config prisma/models/generate-schema.ts && pnpm run generate",
    "db:push": "prisma db push --config prisma.config.ts --accept-data-loss",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=../../apps/web/.env --env-file=../../.env.config prisma/seeders/index.ts"
  },
  "exports": {
    "./*": "./*"
  },
  "peerDependencies": {
    "@prisma/adapter-pg": "*",
    "@prisma/client": "*",
    "@serwist/window": "*",
    "@tanstack/browser-db-sqlite-persistence": "*",
    "@tanstack/db": "*",
    "@tanstack/query-db-collection": "*",
    "@tanstack/react-db": "*",
    "@tanstack/react-form": "*",
    "@tanstack/react-query": "*",
    "@tanstack/react-router": "*",
    "@tanstack/react-start": "*",
    "@tanstack/react-store": "*",
    "@tanstack/react-table": "*",
    "better-auth": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "cmdk": "*",
    "dayjs": "*",
    "lodash": "*",
    "lucide-react": "*",
    "neverthrow": "*",
    "next-themes": "*",
    "pg": "*",
    "radix-ui": "*",
    "react": "*",
    "react-day-picker": "*",
    "react-dom": "*",
    "react-dropzone": "*",
    "react-easy-crop": "*",
    "recharts": "*",
    "resend": "*",
    "shadcn": "*",
    "sonner": "*",
    "stripe": "*",
    "tailwind-merge": "*",
    "tailwindcss": "*",
    "uuid": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@prisma/internals": "*",
    "@types/lodash": "*",
    "@types/pg": "8.11.11",
    "@types/react": "*",
    "@types/react-dom": "*",
    "dotenv": "*",
    "jimp": "*",
    "prisma": "*",
    "tsx": "*",
    "typescript": "*"
  }
}
