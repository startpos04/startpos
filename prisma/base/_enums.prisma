// --- PRODUCT & RESOURCE ENGINE ---
enum ResourceType {
  PHYSICAL_GOOD
  SERVICE
  RAW_MATERIAL
  BUNDLE
}

enum VariantAttributeType {
  SIZE // e.g., Small, Medium, Large, 12oz, 1L
  COLOR // e.g., Red, Blue, Black
  FLAVOR // e.g., Vanilla, Chocolate, Spicy
  MATERIAL // e.g., Cotton, Plastic, Stainless Steel
