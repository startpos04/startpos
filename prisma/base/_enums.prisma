// --- Notifications ---
enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  LOW_STOCK
  NEW_ORDER
  SYSTEM_ALERT
  TASK_ASSIGNED
  TASK_OVERDUE // fires when dueDate is past and task is not yet FULFILLED
  COMPLIANCE_REMINDER
  PURCHASE_PENDING_APPROVAL // D7: A purchase above threshold requires management sign-off
  CREDIT_LOW_BALANCE // Phase 3: fired when prepaid credit balance drops below CREDIT_LOW_BALANCE_THRESHOLD
