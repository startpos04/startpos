  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean
  image         String?
  contactNumber String?
  role          Role    @default(CASHIER)

  sessions           Session[]
  accounts           Account[]
  processedSales     Transaction[]       @relation("CashierRelation")
  performedServices  Transaction[]       @relation("ServiceProvider")
  inventoryMovements InventoryMovement[]
  memberships        Membership[]
  vendorSessions     VendorSession[]
  notifications      Notification[]
  createdTasks       OperationalTask[]   @relation("TaskCreator")
  approvedTasks      OperationalTask[]   @relation("TaskApprover")
  fulfilledTasks     OperationalTask[]   @relation("TaskClerk")
  reviewedTasks      OperationalTask[]   @relation("TaskReviewer")
  canceledTasks      OperationalTask[]   @relation("TaskCanceler")
  receivedGoods      GoodsReceipt[]      @relation("GoodsReceiptReceiver")
  configurations     Configuration[] // Multi-scope configuration system

  // Production Module relations
  productionOrders ProductionOrder[] @relation("ProductionProducer")

  // Legal consent recording — Phase 0
  // Stores the exact version and timestamp when the user accepted the ToS/Privacy Policy.
  // Required for enforcement and audit under RA 10173 and standard SaaS contract law.
  termsAcceptedAt   DateTime?
  termsVersion      String? // e.g. "2026-08-01"
  privacyAcceptedAt DateTime?
  privacyVersion    String? // e.g. "2026-08-01"

  // Authorization System — Phase 0
  // User-specific permission grants and revokes
  userPermissions    UserPermission[]
  permissionsGranted UserPermission[] @relation("PermissionGrantor")

  // Sequence generation audit trail
  sequenceAudits SequenceAudit[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  goodsReceipts GoodsReceipt[]

  @@index([deletedAt])
  @@map("users")
}

// ---------------------------------------------------------------------------
// AuditLog — immutable append-only record of destructive and privilege-
// elevating admin actions. Phase 1 of the Legal Compliance Master Plan.
//
// Design decisions:
//   - businessId is the primary partition key (all tenant queries scoped to it).
//   - actorId is the userId who performed the action (not cascade-deleted on
//     user removal — intentionally kept for forensic purposes).
//   - before/after are nullable JSON snapshots. Sensitive fields (passwords,
//     tokens) are stripped by AuditEngine.stripSensitive() before storage.
//   - No onDelete: Cascade — audit records must outlive the entities they
//     describe. BIR 10-year retention applies to financial audit rows.
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorId    String
  action     String // AuditAction constant — e.g. "EMPLOYEE_DISABLED"
  targetType String // AuditTargetType constant — e.g. "User"
  targetId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([actorId])
  @@index([action, businessId])
  @@map("audit_logs")
}

// =============================================================================
// AUTH MODELS - Session, Account, Verification
// =============================================================================

// --- AUTH SYSTEM ---

// Need for better auth management, but can be extended for other purposes like tracking user sessions, devices, etc.
model Session {
  id         String   @id @default(cuid())
  expiresAt  DateTime
  token      String   @unique
  ipAddress  String?
  userAgent  String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  branchId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

// Need for better auth management, but can be extended for other purposes like tracking user accounts, providers, etc.
model Account {
  id         String  @id @default(cuid())
  accountId  String
  providerId String
  userId     String
  password   String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

// Need for better auth management — used for email verification tokens and OAuth state.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("verifications")
}

// =============================================================================
// TRANSACTION MODELS - Transaction, TransactionTaxLine
// =============================================================================

// --- TRANSACTIONS & SALES ---
model Transaction {
  id                 String             @id @default(cuid())
  invoiceNo          String             @unique
  type               TransactionType    @default(SALE)
  priceConfiguration PriceConfiguration @default(INCLUSIVE)
  invoiceType        InvoiceType        @default(SALES_INVOICE)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  // --- REVENUE VS COST (Line Graph Source) ---
  totalAmount        Int // Total charged to the customer (in cents)
  totalCost          Int // Total cost of goods/services sold (in cents)
  snapshotBufferRate Int // Snapshot of Branch buffer rate at time of transaction

  taxAmount Int // Tax amount (in cents)
  discount  Int @default(0) // Discount amount (in cents)

  // Timing (Hotels/Resorts/Appointments)
  startTime DateTime?
  endTime   DateTime?

  // Contextual Data
  notes String? @db.Text // Clinical notes, room requests, etc.

  // Dynamic Compliance & Regional Data Bucket
  // Holds context metrics safely (e.g., PH Senior/PWD entries, custom buyer fields)
  // PH Format: { "scPwdId": "123", "scPwdName": "Name", "scPwdDiscount": 500, "buyerTin": "000-00" }
  complianceData Json? @default("{}")

  customerId              String?
  customer                Customer? @relation(fields: [customerId], references: [id])
  snapshotCustomerName    String?
  snapshotCustomerTaxId   String?
  snapshotCustomerAddress String?

  // --- SNAPSHOT FIELDS: Phase 3 (Business/Branch/Cashier) ---
  // Captured at time of sale for accurate receipt reprints and BIR audit trail.
  // NULL for transactions created before Phase 3 deployment.
  snapshotBusinessName  String? // Business name at time of sale
  snapshotBranchName    String? // Branch name at time of sale
  snapshotBranchAddress String? // Branch address for receipt printing
  snapshotCurrency      String? // Currency code (e.g., "PHP")
  snapshotCashierName   String? // Cashier name at time of sale

  // COUNTRY_FIELDS: PH
  snapshotBusinessTIN        String? // BIR TIN "000-000-000-000"
  snapshotBranchSN           String? // BIR Branch Serial Number
  snapshotBranchCode         String? // Branch code suffix "00001"
  snapshotIsVATRegistered    Boolean? // VAT registration status
  snapshotPTUNumber          String? // Permit to Use
  snapshotRDOCode            String? // Revenue District Office
  snapshotCustomerTIN        String? // Customer TIN for B2B
  snapshotScPwdId            String? // SC/PWD ID
  snapshotScPwdName          String? // SC/PWD name
  snapshotScPwdDiscount      Int? // Discount amount (cents)
  snapshotBuyerName          String?
  snapshotBuyerTIN           String?
  snapshotBuyerAddress       String?
  snapshotBuyerBusinessStyle String?

  cashierId             String
  cashier               User                 @relation("CashierRelation", fields: [cashierId], references: [id])
  providerId            String?
  provider              User?                @relation("ServiceProvider", fields: [providerId], references: [id])
  sessionId             String?
  session               VendorSession?       @relation(fields: [sessionId], references: [id])
  originalTransactionId String?
  originalTransaction   Transaction?         @relation("RefundReference", fields: [originalTransactionId], references: [id])
  refunds               Transaction[]        @relation("RefundReference")
  payments              Payment[]
  taxLines              TransactionTaxLine[] // Replaces hardcoded PH VAT breakdowns natively

  // Phase 2 — Usage tracking FK (nullable; null for transactions before Phase 2 went live)
  usageCounterId String?
  usageCounter   UsageCounter? @relation(fields: [usageCounterId], references: [id], onDelete: SetNull)

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]

  @@index([businessId, branchId, createdAt])
  @@index([cashierId])
  @@index([usageCounterId])
  @@map("transactions")
}

model TransactionTaxLine {
  id            String      @id @default(cuid())
  type          TaxLineType
  category      TaxCategory
  rate          Float // e.g., 12.0, 9.0
  taxableAmount Int // Net amount subjected to this specific rate tier
  taxAmount     Int // Computed tax component collected

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("transaction_tax_lines")
}

// =============================================================================
// ORDER MODELS - Order, OrderItem, OrderItemAddon
// =============================================================================

// --- ORDERS (KITCHEN/TAB SYSTEM) ---
model Order {
  id                String      @id @default(cuid())
  orderNumber       String
  customerReference String? // e.g., "Buzzer 10", "Table 4"
  status            OrderStatus @default(PREPARING)
  orderType         OrderType   @default(DINE_IN)

  transaction Transaction?

  items OrderItem[]

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, branchId])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Float

  unitPrice Int
  unitCost  Int @default(0)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  // --- SNAPSHOT FIELDS: Phase 1 (Product/Variant/Category) ---
  // Captured at time of sale to preserve historical accuracy when master data changes.
  // NULL for transactions created before Phase 1 deployment.
  snapshotProductName  String? // Product name at time of sale, e.g. "Fried Chicken"
  snapshotVariantName  String? // Variant name at time of sale, e.g. "Large", "Extra Spicy"
  snapshotCategoryName String? // Category name at time of sale, e.g. "Main Dishes"
  snapshotSku          String? // SKU at time of sale
  snapshotProductType  ResourceType? // Product type at time of sale: "PHYSICAL_GOOD", "SERVICE", etc.
  snapshotProductImage String? // Product image URL at time of sale (for digital receipts)

  // --- SNAPSHOT FIELDS: Phase 2 (Unit & Tax) ---
  // Captured at time of sale for accurate unit conversions and tax compliance.
  snapshotUnitName    String? // Unit display name, e.g. "kilogram", "piece"
  snapshotUnitAbbrev  String? // Unit abbreviation, e.g. "kg", "pcs"
  snapshotUnitType    String? // Unit type, e.g. "WEIGHT", "COUNT"
  snapshotTaxCategory TaxCategory? // Tax category at time of sale: STANDARD, EXEMPT, ZERO_RATED

  selectedAddons OrderItemAddon[]

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([businessId, orderId])
  @@map("order_items")
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  addonId           String // Points to a ProductVariant acting as addon
  addon             ProductVariant @relation("AddonToOrderItem", fields: [addonId], references: [id])
  quantity          Float // How much was added (e.g., 2 units)
  snapshotUnitPrice Int // Price charged for this addon at time of sale (in cents)
  snapshotUnitCost  Int            @default(0) // Cost of this addon at time of sale (in cents)

  // --- SNAPSHOT FIELDS: Phase 1 (Addon Details) ---
  // Captured at time of sale to preserve historical accuracy.
  snapshotAddonProductName String? // Addon product name at time of sale, e.g. "Extra Cheese"
  snapshotAddonVariantName String? // Addon variant name at time of sale
  snapshotAddonSku         String? // Addon SKU at time of sale

  // --- SNAPSHOT FIELDS: Phase 2 (Addon Unit & Tax) ---
  snapshotAddonUnitName    String? // Addon unit display name
  snapshotAddonUnitAbbrev  String? // Addon unit abbreviation
  snapshotAddonTaxCategory TaxCategory? // Addon tax category at time of sale

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderItemId])
  @@index([businessId, orderItemId])
  @@index([businessId, branchId])
  @@map("order_item_addons")
}

// =============================================================================
// PRODUCT MODELS - Category, Product, ProductVariant, ProductComponent, Unit, ProductUnit
// =============================================================================

// --- PRODUCT & RESOURCE ENGINE ---
model Category {
  id         String @id @default(cuid())
  name       String
  businessId String

  products Product[]
  business Business  @relation(fields: [businessId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name, businessId])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id              String       @id @default(cuid())
  name            String
  image           String?
  type            ResourceType @default(PHYSICAL_GOOD)
  // Business Specific Flags
  isAvailable     Boolean      @default(true)
  hasExpiry       Boolean      @default(false) // Pharmacy/Food
  requiresDeposit Boolean      @default(false) // LPG/Water/Bottles
  depositAmount   Int?         @db.Integer // Deposit amount if requiresDeposit is true (in cents)
  durationMinutes Int? // Service duration (Clinic/Spa)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  baseUnitId String
  baseUnit   Unit   @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])

  variants ProductVariant[]

  business   Business @relation(fields: [businessId], references: [id])
  businessId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name          String?
  image         String?
  sku           String?              @unique
  price         Int                  @db.Integer // Price charged to customers (in cents to avoid float issues)
  costPrice     Int                  @default(0) @db.Integer // Cost to acquire/make the product (in cents)
  attributeType VariantAttributeType @default(UNSPECIFIED)
  taxCategory   TaxCategory          @default(STANDARD) // Broadened categorization for multi-country support

  lowStockThreshold Int?

  // Production Module — Phase 1: Batch preparation configuration
  // Is this product batch-prepared in advance?
  isBatchPrepared Boolean @default(false)

  // For batch-prepared products, does production use a recipe?
  productionUsesRecipe Boolean @default(true)

  // Optional shelf life configuration (hours after production)
  // Used for warnings only, not automatic waste
  shelfLifeHours Int?

  components ProductComponent[] @relation("ParentVariant")
  usedIn     ProductComponent[] @relation("ComponentVariant")

  inventory          Inventory[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  orderItemAddons    OrderItemAddon[]    @relation("AddonToOrderItem")
  productUnits       ProductUnit[]
  purchaseItems      PurchaseItem[]
  goodsReceiptItems  GoodsReceiptItem[]

  // Production Module relations
  productionTargets   ProductionOrder[]     @relation("ProductionTarget")
  productionMaterials ProductionOrderItem[] @relation("ProductionMaterial")

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([businessId, sku])
  @@index([isBatchPrepared])
  @@map("product_variants")
}

model ProductComponent {
  id           String @id @default(cuid())
  hostId       String
  materialId   String
  unitId       String
  quantityUsed Float // How much of the material is used

  // Behavior Flags
  isAddon       Boolean @default(false) // True if it's a paid extra, False if it's a recipe ingredient
  priceOverride Int?    @db.Integer // Price charged if isAddon is true (in cents)

  unit     Unit           @relation(fields: [unitId], references: [id])
  host     ProductVariant @relation("ParentVariant", fields: [hostId], references: [id])
  material ProductVariant @relation("ComponentVariant", fields: [materialId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([hostId, materialId, isAddon])
  @@index([businessId])
  @@map("product_components")
}

model Unit {
  id           String   @id @default(cuid())
  name         String
  abbreviation String
  type         UnitType

  conversionFactor Float   @default(1)
  isBaseUnit       Boolean @default(false)

  products          Product[]           @relation("ProductBaseUnit")
  components        ProductComponent[]
  inventory         Inventory[]
  movements         InventoryMovement[]
  orderItems        OrderItem[]
  productUnits      ProductUnit[]
  purchaseItems     PurchaseItem[]
  goodsReceiptItems GoodsReceiptItem[]

  // Production Module relations
  productionTargetUnits   ProductionOrder[]     @relation("ProductionTargetUnit")
  productionMaterialUnits ProductionOrderItem[] @relation("ProductionMaterialUnit")

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name, businessId])
  @@unique([abbreviation, businessId])
  @@index([deletedAt])
  @@map("units")
}

model ProductUnit {
  id             String  @id @default(cuid())
  variantId      String
  unitId         String
  isPurchaseUnit Boolean @default(false)
  isSalesUnit    Boolean @default(true)

  conversionFactor Float @default(1)

  variant ProductVariant @relation(fields: [variantId], references: [id])
  unit    Unit           @relation(fields: [unitId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([variantId, unitId])
  @@index([businessId])
  @@map("product_units")
}

// =============================================================================
// INVENTORY MODELS - Location, Inventory, InventoryMovement, Customer, Supplier, Purchase, PurchaseItem, GoodsReceipt, GoodsReceiptItem, ProductionOrder, ProductionOrderItem
// =============================================================================

// --- INVENTORY & BATCH TRACKING ---
model Location {
  id          String  @id @default(cuid())
  name        String // e.g., "Warehouse A", "Main Counter Freezer", "Display Rack 1"
  description String?
  contact     String?
  address     String?

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name, branchId])
  @@index([deletedAt])
  @@map("locations")
}

model Inventory {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  unitId      String
  unit        Unit           @relation(fields: [unitId], references: [id])
  batchNumber String?
  expiryDate  DateTime?
  quantity    Float
  costPrice   Int            @default(0) // Cost per unit (in cents) for this specific batch

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Production Module — Phase 1: Batch preparation tracking
  inventoryType InventoryType @default(RAW_MATERIAL) // Distinguish raw materials from finished goods

  // Link to production batch if this is finished goods
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  // When was this batch produced (for FIFO and shelf life tracking)
  producedAt DateTime?

  // Optimistic locking for concurrency control (CRITICAL for POS sales)
  // Prevents race condition when two terminals sell last units simultaneously
  // See CONCURRENCY-CONTROL-REQUIREMENT.md for details
  version Int @default(1)

  inventoryMovements InventoryMovement[] @relation("SourceInventory")

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branch     Branch   @relation(fields: [branchId], references: [id])
  branchId   String

  lastRestocked DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId, branchId, variantId])
  @@index([inventoryType, branchId])
  @@map("inventory")
}

model InventoryMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  type      MovementType
  quantity  Float
  reason    String?
  unitId    String
  unit      Unit           @relation(fields: [unitId], references: [id])

  inventoryId String
  inventory   Inventory @relation("SourceInventory", fields: [inventoryId], references: [id])

  targetBranchId String?
  targetBranch   Branch? @relation("DestinationBranch", fields: [targetBranchId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  // Production Module — Phase 1: Link to production order
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  operationalTask   OperationalTask? @relation(fields: [operationalTaskId], references: [id])
  operationalTaskId String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String
  branch     Branch   @relation("SourceBranch", fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, branchId, variantId, createdAt])
  @@map("inventory_movements")
}

// --- CUSTOMER RECORDS ---
model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String?   @unique
  phone       String?
  dateOfBirth DateTime?

  taxId   String? // Abstracted from tin (Required for Corporate Sales globally)
  address String? // Required for large-value billing tracking across borders

  transactions Transaction[]

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("customers")
}

// --- PURCHASING (EXPENDITURE TRACKING) ---
model Supplier {
  id        String  @id @default(cuid())
  name      String // e.g., "San Miguel Corp", "Mega Q-Mart Wholesale"
  taxId     String? // Supplier's TIN for cost-side tax audit compliance
  contactNo String?
  email     String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  purchases Purchase[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name, businessId]) // Clean tenant scope
  @@map("suppliers")
}

model Purchase {
  id         String         @id @default(cuid())
  purchaseId String
  status     PurchaseStatus @default(RECEIVED) // RECEIVED preserves backward compat for existing records
  totalCost  Int // Total cost of the purchase (in cents)
  notes      String?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  items              PurchaseItem[]
  goodsReceipts      GoodsReceipt[]
  inventoryMovements InventoryMovement[]
  operationalTask    OperationalTask?    @relation(fields: [operationalTaskId], references: [id])
  operationalTaskId  String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchases")
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Float
  unitId     String
  unit       Unit           @relation(fields: [unitId], references: [id])
  unitCost   Int

  goodsReceiptItems GoodsReceiptItem[]

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  @@index([businessId, branchId])
  @@map("purchase_items")
}

// NOTE: GoodsReceipt, GoodsReceiptItem, ProductionOrder, and ProductionOrderItem
// models are now in dedicated base files: base/goods-receipt.prisma and base/production.prisma

// =============================================================================
// CONFIGURATION MODELS - ConfigurationDefinition, Configuration
// =============================================================================

// --- CONFIGURATION SYSTEM (Three-Pillar Architecture) ---

// Configuration Definition (Base Layer) - Defines available configurations
model ConfigurationDefinition {
  id           String             @id // Same as key for simplicity (e.g., "PRIMARY_TAX_RATE")
  key          ConfigurationKey   @unique
  label        String // Display name
  description  String? // Help text
  category     ConfigCategory // TAX, OPERATIONAL, LOCALE, etc.
  dataType     ConfigDataType // STRING, NUMBER, BOOLEAN, JSON
  defaultValue String // Platform default
  scope        ConfigurationScope // Where this config can be set
  required     Boolean            @default(false)
  validation   Json? // Validation rules (min, max, regex, enum values)

  // Country-specific overrides
  countryCode String? // If null, applies to all countries

  configurations Configuration[] // References from actual config instances

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configuration_definitions")
}

// Configuration (State Layer) - Actual configuration values at any scope (Platform/Business/Branch/User)
model Configuration {
  id    String             @id @default(cuid())
  key   ConfigurationKey
  value String // Stored as a string representation (e.g., "20", "true", "INCLUSIVE", "en-PH")
  scope ConfigurationScope

  // Reference to definition (for metadata, validation)
  definition ConfigurationDefinition @relation(fields: [key], references: [key])

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, businessId, scope])
  @@unique([key, branchId, scope])
  @@unique([key, userId, scope])
  @@index([key])
  @@map("configurations")
}

// NOTE: Country-specific compliance tables (PhilippinesCompliance, SingaporeCompliance, UsaCompliance)
// are now generated from countries/*.prisma files and injected as standalone models

// =============================================================================
// BRANCH CAPABILITY CONFIGURATION
// =============================================================================
// Branch-level capability toggles - allows branch managers to enable/disable
// specific capabilities for their branch, independent of the business-wide
// capability states.

model BranchCapabilityConfig {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  capabilityId String // e.g., "CREATE_ORDER", "RECORD_PAYMENT"
  enabled      Boolean @default(true) // true = enabled at branch, false = disabled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, capabilityId])
  @@index([branchId])
  @@map("branch_capability_configs")
}

// =============================================================================
// CAPABILITY CONFIGURATION
// =============================================================================
// Flexible per-capability settings storage. Each capability can define its own
// configuration keys without requiring schema changes. Supports branch-level
// and business-level scoping.
//
// Examples:
//   - COMPLETE_CHECKOUT → allowed_payment_methods: "CASH,E_WALLET,CARD"
//   - MANAGE_INVENTORY → low_stock_threshold: "10"
//   - PRINT_RECEIPT → receipt_layout: "STANDARD"
//
// Design:
//   - capabilityId namespaces settings per capability
//   - key is freeform string (no enum constraint)
//   - value stored as string (parse based on dataType)
//   - dataType hints at how to parse value (BOOLEAN, STRING, JSON, NUMBER)
//   - scope determines if setting applies at BRANCH or BUSINESS level

model CapabilityConfiguration {
  id           String             @id @default(cuid())
  capabilityId String // e.g., "COMPLETE_CHECKOUT", "MANAGE_INVENTORY"
  key          String // e.g., "allowed_payment_methods", "low_stock_threshold"
  value        String // Stored as string, parse based on dataType
  dataType     ConfigDataType // BOOLEAN, STRING, JSON, NUMBER (reuse existing enum)
  scope        ConfigurationScope // BRANCH or BUSINESS

  // Scope references
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([capabilityId, key, branchId, scope])
  @@unique([capabilityId, key, businessId, scope])
  @@index([capabilityId, branchId])
  @@index([capabilityId, businessId])
  @@map("capability_configurations")
}

// =============================================================================
// BILLING MODELS - BusinessSubscription, SubscriptionStatusHistory, Feature, SubscriptionPlan, PlanEntitlement, EntitlementOverride, UsageCounter, BillingInvoice, BillingInvoiceItem, CreditLedger
// =============================================================================

// --- ENTITLEMENT ENGINE — Phase 2 / Phase F ---

// ---------------------------------------------------------------------------
// BusinessSubscription — Phase 0 (expanded from F1 stub)
// The active subscription record for a business.
// One business has at most one active subscription at a time.
//
// Fields added in Phase 0:
//   billingModel       — which billing strategy applies
//   gracePeriodEndsAt  — when the grace window closes after a lapse
//   longTermInactiveAt — when the account was downgraded to long-term inactive
//   expiredAt          — when the subscription first lapsed (GRACE_PERIOD start)
//   cancelReason       — free-text reason recorded at cancellation
//   externalId         — payment provider subscription ID (Stripe etc.) — Phase 4
//   statusHistory      — immutable audit log relation
//
// DEPRECATED fields (superseded in later phases but NOT removed yet):
//   txUsedThisPeriod   → replaced by UsageCounter model in Phase 2
//   creditBalance      → replaced by CreditLedger model in Phase 3
// ---------------------------------------------------------------------------
model BusinessSubscription {
  id         String             @id @default(cuid())
  businessId String             @unique // One active subscription per business (enforced via unique)
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId     String
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])
  status     SubscriptionStatus @default(TRIAL)

  // Phase 0 — Billing model strategy
  billingModel BillingModel @default(MONTHLY_SUBSCRIPTION)

  // Billing period dates
  trialEndsAt        DateTime? // Set when status = TRIAL; null = no trial
  currentPeriodStart DateTime? // Start of the current paid billing period
  currentPeriodEnd   DateTime? // End of the current paid billing period; null = open-ended

  // Phase 0 — Lifecycle tracking dates
  gracePeriodEndsAt  DateTime? // When GRACE_PERIOD window closes; null = not in grace period
  expiredAt          DateTime? // When the subscription first lapsed (transition to EXPIRED)
  longTermInactiveAt DateTime? // When account was downgraded to LONG_TERM_INACTIVE

  // DEPRECATED (Phase 0): txUsedThisPeriod — will be superseded by UsageCounter in Phase 2.
  // Kept to avoid breaking getAuthUser entitlement assembly during Phase 0.
  // DO NOT write to this field in new code after Phase 2 is merged.
  txUsedThisPeriod Int @default(0)

  // DEPRECATED (Phase 0): creditBalance — will be superseded by CreditLedger in Phase 3.
  // Kept to avoid breaking getAuthUser entitlement assembly during Phase 0.
  // DO NOT write to this field in new code after Phase 3 is merged.
  creditBalance Int?

  // Phase 0 — Cancellation audit
  cancelReason String? // Free-text reason recorded at cancellation time

  // Phase 4 — External billing provider reference (e.g. Stripe subscription ID)
  externalId String? // Populated when payment provider subscription is created

  // Timestamps (some pre-existed from F1, some added in Phase 0)
  activatedAt DateTime? // When the subscription first became ACTIVE
  cancelledAt DateTime? // When the subscription was cancelled (if applicable)
  suspendedAt DateTime? // When the subscription was manually suspended

  // Phase 0 — Status transition audit log
  statusHistory SubscriptionStatusHistory[]

  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  businessSubscriptionFeatures BusinessSubscriptionFeature[]

  @@index([businessId, status])
  @@map("business_subscriptions")
}

// ---------------------------------------------------------------------------
// SubscriptionStatusHistory — Phase 0
// Immutable append-only audit log of every subscription status transition.
// Written by SubscriptionEngine transition helpers and the lifecycle background job.
// Never updated after creation.
// ---------------------------------------------------------------------------
model SubscriptionStatusHistory {
  id             String               @id @default(cuid())
  subscriptionId String
  subscription   BusinessSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  fromStatus SubscriptionStatus? // null = initial record (subscription created)
  toStatus   SubscriptionStatus

  reason      String? // Human-readable reason for the transition
  triggeredBy String? // userId of the actor, or "system" for automated job transitions

  createdAt DateTime @default(now())

  @@index([subscriptionId, createdAt])
  @@map("subscription_status_history")
}

// ---------------------------------------------------------------------------
// Feature
// Registry of every capability the application can gate.
// Decoupled from plan names — new features can be added without touching plans.
// ---------------------------------------------------------------------------
model Feature {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "COMPLETE_CHECKOUT", "CREATE_ORDER"
  label       String // Human-readable label for admin UI
  description String?

  // true  = blocked when subscription lapses (operational)
  // false = always accessible regardless of billing status (management)
  isOperational Boolean @default(false)

  // Phase 5b — Composable pricing fields
  // isSelectableByCustomer: true = appears in the pricing calculator for COMPOSABLE_FEATURES subscriptions
  isSelectableByCustomer Boolean          @default(false)
  pricingCategory        PricingCategory?
  sortOrder              Int              @default(0) // Display ordering within pricingCategory

  entitlements PlanEntitlement[]
  overrides    EntitlementOverride[]

  // Phase 5 relations
  prices                       FeaturePrice[]
  bundleItems                  FeatureBundleItem[]
  dependencies                 FeatureDependency[]           @relation("FeatureDependencies")
  dependents                   FeatureDependency[]           @relation("FeatureDependents")
  businessSubscriptionFeatures BusinessSubscriptionFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("features")
}

// ---------------------------------------------------------------------------
// SubscriptionPlan
// Configurable tier registry. Names ("Starter", "Professional") are labels;
// the engine never branches on plan name — only on entitlements.
// ---------------------------------------------------------------------------
model SubscriptionPlan {
  id          String  @id @default(cuid())
  name        String  @unique // "Starter", "Professional", "Enterprise", "Trial"
  description String?
  isActive    Boolean @default(true) // Soft-disable without deleting
  sortOrder   Int     @default(0) // Display ordering

  // Billing
  monthlyPrice       Int // In cents. 0 = free trial base plan
  annualPrice        Int? // In cents. null = use monthlyPrice × 12 (no annual discount configured)
  includedTxPerMonth Int // Monthly transaction allowance. -1 = unlimited
  overagePerTx       Int  @default(0) // Cents per tx over allowance. 0 = block instead of charge

  entitlements PlanEntitlement[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  businessSubscriptions BusinessSubscription[]

  @@map("subscription_plans")
}

// ---------------------------------------------------------------------------
// PlanEntitlement
// Join table between a plan and its features.
// A plan "has" a feature if a record exists here.
// ---------------------------------------------------------------------------
model PlanEntitlement {
  id         String           @id @default(cuid())
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  feature    Feature          @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  // Optional per-entitlement usage cap (null = unlimited)
  // e.g. max 5 employees for Starter, max 20 for Professional
  usageLimit Int?

  @@unique([planId, featureKey])
  @@map("plan_entitlements")
}

// ---------------------------------------------------------------------------
// EntitlementOverride
// Per-business exceptions: promotional access, enterprise contracts,
// temporary grants, or explicit revocations — without changing the plan.
// ---------------------------------------------------------------------------
model EntitlementOverride {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureKey String
  feature    Feature  @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  // false = explicitly revoke a feature even if the plan includes it
  granted   Boolean   @default(true)
  expiresAt DateTime?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, featureKey])
  @@map("entitlement_overrides")
}

// ---------------------------------------------------------------------------
// Phase 2 — Usage Tracking + Monthly Billing Foundation
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// UsageCounter — Phase 2
// Tracks the number of POS transactions processed in a given billing period.
// One row per (businessId, billingPeriodStart). The row is opened at the
// start of each billing period and incremented synchronously on every checkout.
//
// Design decisions:
//   - txCount is the source of truth for txRemaining in EntitlementEngine.
//   - overageTxCount is the count of transactions beyond the plan's
//     includedTxPerMonth allowance (only relevant when OVERAGE_BILLING_ENABLED).
//   - The row is "closed" (isClosed = true) by the usage-counter-reset job
//     at period end; it is never deleted.
//   - businessId + billingPeriodStart is unique — reset job idempotency check.
// ---------------------------------------------------------------------------
model UsageCounter {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // The billing period this counter tracks (mirrors BusinessSubscription.currentPeriodStart)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime

  // Transaction counts (per branch)
  txCount        Int @default(0) // Total transactions processed at this branch in this period
  overageTxCount Int @default(0) // Transactions beyond branch's allocated allowance

  // isClosed = true once the period has ended and the reset job has run.
  // A closed counter is never mutated. A new counter is opened for the next period.
  isClosed Boolean @default(false)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, branchId, billingPeriodStart])
  @@index([businessId, isClosed])
  @@index([branchId, isClosed])
  @@map("usage_counters")
}

// ---------------------------------------------------------------------------
// BillingInvoice — Phase 2
// Represents a billing invoice generated at the end of a billing period.
// One invoice per (businessId, billingPeriodStart) in the typical case.
// Invoice line items are in BillingInvoiceItem.
// ---------------------------------------------------------------------------
model BillingInvoice {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // The billing period this invoice covers
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime

  status InvoiceStatus @default(DRAFT)

  // Totals (all values in cents)
  subtotalAmount Int @default(0) // Sum of all line items before tax
  taxAmount      Int @default(0) // Tax on this invoice
  totalAmount    Int @default(0) // subtotal + tax

  // Phase 4 — external billing provider reference
  externalInvoiceId String? // e.g. Stripe invoice ID

  dueAt  DateTime? // Payment due date
  paidAt DateTime? // When payment was confirmed

  items BillingInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, billingPeriodStart])
  @@index([status])
  @@map("billing_invoices")
}

// ---------------------------------------------------------------------------
// BillingInvoiceItem — Phase 2
// A single line item on a BillingInvoice.
// ---------------------------------------------------------------------------
model BillingInvoiceItem {
  id        String         @id @default(cuid())
  invoiceId String
  invoice   BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type        InvoiceItemType
  description String

  // Quantity × unitAmount = lineAmount (all in cents)
  quantity   Int // e.g. number of overage transactions, or 1 for subscription fee
  unitAmount Int // Cents per unit
  lineAmount Int // quantity × unitAmount (pre-computed, stored for audit stability)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("billing_invoice_items")
}

// ---------------------------------------------------------------------------
// Phase 3 — Prepaid Credits
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// CreditLedger — Phase 3 + Branch Billing
// Append-only ledger of every credit event per branch.
// Each branch has independent credit balance for P&L accounting.
// The current balance for a branch is the `balanceAfter` of its most recent row.
//
// Design decisions:
//   - Append-only: rows are never updated or deleted; every event adds a row.
//   - Per-branch tracking: Each branch purchases and tracks credits independently
//   - `balanceAfter` is a snapshot — O(1) balance read per branch (no SUM query needed).
//   - `amount` is signed: positive = credit in, negative = credit out.
//   - The `transactionId` FK is nullable — not all events come from a POS TX.
//   - Business-level aggregation: Sum balanceAfter of latest row per branch for consolidated view
//   - Race condition note (Phase 3 known limitation): two concurrent deductions
//     may both read the same `balanceAfter` before either commits, allowing the
//     balance to go temporarily negative. This is auditable via the ledger and
//     will be hardened with an optimistic lock in a future phase.
//   - stripeSessionId: Idempotency key for webhook handling (prevents duplicate credit grants)
//
// Branch Billing Usage:
//   - Branches purchase credits when they need extra transaction capacity
//   - Credits act as overflow when business quota is managed/limited by owner
//   - Each transaction deducts 1 credit from branch balance
// ---------------------------------------------------------------------------
model CreditLedger {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  eventType CreditEventType

  // Signed amount in credit units (positive = add, negative = deduct)
  amount Int

  // Running balance snapshot for this branch after this event is applied.
  // The most recent row's balanceAfter for a branch is that branch's current balance.
  balanceAfter Int

  // Optional reference to the POS transaction that triggered this event.
  // Null for PURCHASE, PROMOTIONAL, ADJUSTMENT, EXPIRED events.
  transactionId String?

  // Optional human-readable note (required for ADJUSTMENT events)
  note String?

  // The user (admin) who triggered this event; null = system / automated
  actorId String?

  // Idempotency key — prevents duplicate credit grants on Stripe webhook retry
  stripeSessionId String? @unique

  createdAt DateTime @default(now())

  @@index([businessId, branchId, createdAt])
  @@index([branchId, createdAt])
  @@index([transactionId])
  @@map("credit_ledger")
}

// ---------------------------------------------------------------------------
// BusinessSubscriptionAddon — Phase TX-Addon
// Records a purchased add-on that augments the base plan for a business.
// Currently supports:
//   - TX_TOPUP: one-time extra transaction quota for the current billing period (legacy)
//   - TX_RECURRING: monthly recurring TX top-up subscription
//   - ANALYTICS, API_ACCESS, BRANCH, EMPLOYEE: monthly recurring capability addons
//
// expiresAt = billingPeriodEnd of the period it was purchased for, set by
// the webhook handler. Expired addons are excluded from the txRemaining
// calculation in auth-server.ts and entitlement-middleware.ts.
// ---------------------------------------------------------------------------
model BusinessSubscriptionAddon {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  addonType AddonType

  // TX_TOPUP: number of extra transactions granted by this addon
  quantity Int

  // Stripe session that triggered this addon grant (idempotency key for one-time payments)
  externalSessionId String? @unique

  // Stripe subscription ID for recurring addons (TX_RECURRING, ANALYTICS, API_ACCESS, BRANCH, EMPLOYEE)
  // Null for one-time TX_TOPUP addons.
  externalSubscriptionId String? @unique

  // When this addon expires (set to currentPeriodEnd of the billing period
  // it was purchased for). Null = never expires (perpetual top-up).
  expiresAt DateTime?

  // The user who triggered the purchase (from Stripe session metadata)
  actorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, addonType])
  @@index([businessId, expiresAt])
  @@map("business_subscription_addons")
}

// ---------------------------------------------------------------------------
// BusinessSubscriptionFeature — Phase 5 (Composable Pricing)
// Tracks individually selected features in a composable subscription.
//
// EntitlementEngine resolves capabilities from these records when
// billingModel = COMPOSABLE_FEATURES (instead of PlanEntitlement).
// ---------------------------------------------------------------------------
model BusinessSubscriptionFeature {
  id             String               @id @default(cuid())
  subscriptionId String
  subscription   BusinessSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  featureKey String
  feature    Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  // Price snapshot at the time of quote conversion (in cents/month).
  // Preserved for grandfathered-price detection on renewal.
  snapshotPrice Int

  // The catalog version active when this feature was added.
  catalogVersion Int

  activatedAt DateTime @default(now())

  @@unique([subscriptionId, featureKey])
  @@index([subscriptionId])
  @@map("business_subscription_features")
}

// =============================================================================
// AUTHORIZATION SYSTEM (Phase 0)
// =============================================================================

// Permission definitions (mirrors Feature table pattern)
model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g., "business:manage:billing"
  name        String // e.g., "Manage Business Billing"
  description String? // Human-readable description
  scope       PermissionScope // business | branch | user
  resource    String // e.g., "billing", "employees", "products"
  action      PermissionAction // view | manage | create | edit | delete | export
  category    String? // Grouping for UI (e.g., "Business Management", "Branch Operations")
  isSystem    Boolean          @default(true) // System permissions can't be deleted
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  userPermissions UserPermission[]
  roleDefaults    RoleDefaultPermission[]

  @@index([scope, resource, action])
  @@index([category])
  @@map("permissions")
}

// User permissions (actual grants to users)
model UserPermission {
  id           String    @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean   @default(true) // true = granted, false = explicitly revoked
  grantedBy    String? // User ID who granted this permission
  grantedAt    DateTime  @default(now())
  expiresAt    DateTime? // Optional expiration for temporary grants
  note         String? // Reason for grant/revoke

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantor    User?      @relation("PermissionGrantor", fields: [grantedBy], references: [id])

  @@unique([userId, permissionId])
  @@index([userId, granted])
  @@index([permissionId])
  @@map("user_permissions")
}

// Role default permissions (what permissions each role gets by default)
model RoleDefaultPermission {
  id           String   @id @default(cuid())
  role         Role
  permissionId String
  createdAt    DateTime @default(now())

  // Relations
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_default_permissions")
}

// =============================================================================
// OPERATIONAL SYSTEMS - VendorSession, Payment, Notification, SequenceCounter, OperationalTask
// =============================================================================

// --- VENDOR SESSION SYSTEM ---
// Added for tracking when a street food seller goes out and returns for reconciliation.
model VendorSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  startTime    DateTime      @default(now())
  endTime      DateTime?
  openingCash  Int           @default(0)
  closingCash  Int?
  expectedCash Int?
  verifiedCash Int?
  status       SessionStatus @default(OPEN)
  notes        String?

  transactions Transaction[]

  operationalTask   OperationalTask @relation(fields: [operationalTaskId], references: [id])
  operationalTaskId String          @unique

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  @@index([businessId, branchId])
  @@map("vendor_sessions")
}

model Payment {
  id          String        @id @default(cuid())
  amount      Int // The actual amount applied to the bill
  tendered    Int // The raw amount handed over (for cash)
  change      Int // Tendered - amount
  method      PaymentMethod @default(CASH)
  platform    String?
  referenceNo String? // Reference # for GCash/Maya/Cards

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, branchId])
  @@map("payments")
}

// --- Notifications ---
model Notification {
  id       String               @id @default(cuid())
  title    String
  message  String
  type     NotificationType
  priority NotificationPriority @default(MEDIUM)
  isRead   Boolean              @default(false)
  link     String? // URL or App Route to redirect the user (e.g., /orders/123)
  metadata Json

  // Targeting
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Scoping (Important for Multi-tenancy)
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])

  createdAt  DateTime  @default(now())
  archivedAt DateTime? // Soft-archive after retention period (see P-NOTIF archival policy)

  @@index([userId, isRead, archivedAt])
  @@index([businessId])
  @@map("notifications")
}

model SequenceCounter {
  id         String       @id @default(cuid())
  businessId String
  branchId   String
  type       SequenceType // Changed from String to SequenceType

  // Tracking time-based resets
  year  Int
  month Int? // Optional: for monthly reporting
  day   Int? // Optional: Only used if type == ORDER

  lastNumber Int @default(0)

  // Offline mode tracking - prevents multi-cashier conflicts in offline mode
  offlineCashierId String? // Set when device goes offline; tracks which cashier owns this sequence
  offlineDeviceId  String? // Device identifier to prevent multi-device conflicts
  isOfflineMode    Boolean @default(false) // True when sequence is in offline-only mode

  business Business @relation(fields: [businessId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, branchId, type, year, month, day])
  @@map("sequence_counters")
}

// Audit trail for sequence number generation
// Tracks which cashier generated which sequence number, when, and on which device
model SequenceAudit {
  id             String       @id @default(cuid())
  businessId     String
  branchId       String
  type           SequenceType
  sequenceNumber Int // The actual number generated
  generatedBy    String // User ID who triggered the generation
  deviceId       String? // Device identifier (for offline tracking)
  wasOffline     Boolean      @default(false) // Was this generated in offline mode?
  transactionId  String? // Link to the transaction that used this sequence

  business Business @relation(fields: [businessId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  user     User     @relation(fields: [generatedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, branchId, type])
  @@index([generatedBy])
  @@index([transactionId])
  @@map("sequence_audits")
}

// --- TASKS MANAGEMENT ---
model OperationalTask {
  id      String     @id @default(cuid())
  type    TaskType
  status  TaskStatus @default(DRAFT)
  notes   String?
  dueDate DateTime?

  // Accountability
  creatorId  String?
  creator    User?   @relation("TaskCreator", fields: [creatorId], references: [id])
  approverId String?
  approver   User?   @relation("TaskApprover", fields: [approverId], references: [id])
  clerkId    String?
  clerk      User?   @relation("TaskClerk", fields: [clerkId], references: [id])
  reviewerId String?
  reviewer   User?   @relation("TaskReviewer", fields: [reviewerId], references: [id])
  cancelerId String?
  canceler   User?   @relation("TaskCanceler", fields: [cancelerId], references: [id])

  // The "Context"
  // Store variantId, purchaseId, vendorSessionId, etc., inside this JSON
  // Example: { "variantId": "123", "source": "Backroom" }
  metadata Json? @default("{}")

  approvedAt   DateTime?
  inProgressAt DateTime?
  fulfilledAt  DateTime?
  reviewedAt   DateTime?
  canceledAt   DateTime?

  purchases          Purchase[]
  vendorSessions     VendorSession[]
  inventoryMovements InventoryMovement[]

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, branchId, status])
  @@index([type])
  @@index([clerkId])
  @@index([reviewerId])
  @@map("operational_tasks")
}

// =============================================================================
// BUSINESS OPERATING SYSTEM (BOS) - Phase 1
// Capability lifecycle, event log, and recalculation queue
// =============================================================================

// ---------------------------------------------------------------------------
// BusinessCapabilityState
// Tracks the lifecycle state of each capability per business.
// Populated at registration (ENABLED vs DEFERRED based on CapabilityResolver).
// Updated by CapabilityControl (Phase 3a) and RecommendationEngine (Phase 2+).
// ---------------------------------------------------------------------------
model BusinessCapabilityState {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  capabilityId String

  // CapabilityLifecycleState: HIDDEN | RECOMMENDED | ENABLED | CONFIGURED | PAUSED | DEPRECATED
  state      String
  confidence Float    @default(0)
  enteredAt  DateTime @default(now())
  // userId of the actor, or 'system' for automated transitions
  enteredBy  String?

  // Recommendation metadata (populated by RecommendationEngine in Phase 2+)
  recommendationReason String?
  recommendationScore  Float?

  // Analytics timestamps (Phase 6)
  // recommendedAt: when this capability first entered RECOMMENDED state
  // enabledAt: when this capability first entered ENABLED state
  // Used to compute time-to-enable and acceptance rate in recommendation analytics.
  recommendedAt DateTime?
  enabledAt     DateTime?

  // Dismiss / ignore tracking (used by CapabilityControl in Phase 3a)
  dismissedAt        DateTime?
  dismissalCount     Int       @default(0)
  permanentlyIgnored Boolean   @default(false)

  // Audit trail — immutable append-only JSON array of state transitions
  // Each entry: { state, changedAt, changedBy, reason }
  previousState String?
  stateHistory  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, capabilityId])
  @@index([businessId, state])
  @@map("business_capability_states")
}

// ---------------------------------------------------------------------------
// BusinessEventLog
// Persists all significant business events for observation and replay.
// Consumed by CharacteristicsEngine (Phase 2+) to update living characteristics.
//
// Emit via BusinessEventBus.emit() — never write directly to this table
// from a server function. Phase 2 adds Prisma middleware for automatic emission.
//
// Index strategy:
//   [businessId, occurredAt] — time-range queries per business
//   [type, businessId]       — event-type queries (observation rules)
// ---------------------------------------------------------------------------
model BusinessEventLog {
  id         String   @id @default(cuid())
  // BusinessEventType enum value
  type       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  actorId    String?
  occurredAt DateTime @default(now())
  // Arbitrary event-specific data (e.g. { supplierId, supplierName })
  payload    Json     @default("{}")

  @@index([businessId, occurredAt])
  @@index([type, businessId])
  @@map("business_event_log")
}

// ---------------------------------------------------------------------------
// CharacteristicsRecalculationQueue — R1 (DB-backed, replaces in-memory map)
//
// One row per businessId (UNIQUE constraint). The scheduler upserts; the job
// runner queries WHERE processedAt IS NULL.
//
// On server restart: pending rows survive — nothing is silently lost.
// Multi-instance: use SELECT FOR UPDATE SKIP LOCKED in the job runner.
//
// Priority: higher number = processed first.
//   0   = background decay sweep
//   10  = deferred event batch (supplier added, product created)
//   100 = immediate (branch created, config changed, subscription upgraded)
// ---------------------------------------------------------------------------
model CharacteristicsRecalculationQueue {
  id         String   @id @default(cuid())
  businessId String   @unique @map("business_id") // One pending entry per business (deduplication)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Higher number = higher priority
  priority    Int       @default(0)
  scheduledAt DateTime  @default(now()) @map("scheduled_at")
  // null = pending; set by job runner when processing begins
  processedAt DateTime? @map("processed_at")

  // Retry tracking
  attempts  Int     @default(0)
  lastError String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([processedAt, priority])
  @@map("characteristics_recalculation_queue")
}

// ---------------------------------------------------------------------------
// BusinessUsageSummary — Phase 2 (precomputed usage aggregates)
// Replaces expensive on-the-fly COUNT() queries across Transaction/Branch/User.
// One row per business per billing period (not per calendar month — follows
// subscription anniversary date).
//
// Updated by:
//   - Transaction creation (txCount++)
//   - Branch creation (activeBranchCount++)
//   - Membership creation/deletion (activeUserCount ++)
//   - Feature usage tracking (e.g., API call counter)
//
// Used by:
//   - EntitlementEngine (real-time limit checks)
//   - Usage analytics dashboard
//   - Invoice generation
//   - Overage billing calculations
//
// Index strategy:
//   [businessId, periodEnd] — fast lookups for current/past periods
// ---------------------------------------------------------------------------
model BusinessUsageSummary {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  txCount           Int @default(0)
  activeBranchCount Int @default(0)
  activeUserCount   Int @default(0)

  // Extensible for future metered resources
  // Example: { "apiCalls": 150, "emailsSent": 200, "reportsGenerated": 10 }
  additionalMetrics Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, periodEnd])
  @@index([businessId, periodEnd])
  @@map("business_usage_summaries")
}

// =============================================================================
// GUIDANCE SYSTEM - Hints & HintLog
// =============================================================================

// ---------------------------------------------------------------------------
// Hint — contextual guidance tooltips shown to users across the app.
// Managed via admin UI in Phase C; seeded in Phase A.
// ---------------------------------------------------------------------------
model Hint {
  id        String    @id @default(cuid())
  title     String
  body      String
  page      String? // null = global; "/pos" = POS only; "/products" = products only
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  logs      HintLog[]

  @@map("hints")
}

// ---------------------------------------------------------------------------
// HintLog — records when each hint was last shown to each user.
// Used by HintEngine to enforce HINT_FREQUENCY_DAYS per user.
// ---------------------------------------------------------------------------
model HintLog {
  id      String   @id @default(cuid())
  hintId  String
  hint    Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)
  userId  String
  shownAt DateTime @default(now())

  @@index([userId, hintId])
  @@index([userId, shownAt])
  @@map("hint_logs")
}

// =============================================================================
// PRODUCTION MODULE - ProductionOrder, ProductionOrderItem
// =============================================================================

// Production Order — formal record of batch preparation
// Used for both recipe-based and recipe-free production
model ProductionOrder {
  id          String           @id @default(cuid())
  orderNumber String // e.g., "PREP-2024-001" or "PROD-2024-001"
  status      ProductionStatus @default(DRAFT)

  // What are we producing?
  targetVariantId String
  targetVariant   ProductVariant @relation("ProductionTarget", fields: [targetVariantId], references: [id])
  targetQuantity  Float // How many units to produce
  targetUnitId    String
  targetUnit      Unit           @relation("ProductionTargetUnit", fields: [targetUnitId], references: [id])

  // Actual output (may differ from target due to waste/efficiency)
  actualQuantity Float?

  // Does this production use a recipe?
  usesRecipe Boolean @default(true)

  // Production metadata
  startedAt    DateTime?
  completedAt  DateTime?
  producedById String?
  producedBy   User?     @relation("ProductionProducer", fields: [producedById], references: [id])
  notes        String?

  // Cost tracking (only for recipe-based production)
  totalCost Int @default(0) @db.Integer // Total cost of materials used (in cents)

  // Relations
  items              ProductionOrderItem[] // Empty if usesRecipe = false
  inventoryMovements InventoryMovement[]
  finishedInventory  Inventory[] // The finished goods created by this production

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderNumber, businessId])
  @@index([businessId, branchId, status])
  @@index([targetVariantId])
  @@index([completedAt]) // For filtering by production date
  @@map("production_orders")
}

// Line items showing which raw materials were consumed (only for recipe-based production)
model ProductionOrderItem {
  id String @id @default(cuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  // Which raw material was consumed
  materialVariantId String
  materialVariant   ProductVariant @relation("ProductionMaterial", fields: [materialVariantId], references: [id])

  // Quantity consumed
  quantityUsed Float
  unitId       String
  unit         Unit   @relation("ProductionMaterialUnit", fields: [unitId], references: [id])

  // Cost per unit at time of consumption
  unitCost Int @db.Integer

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  @@index([productionOrderId])
  @@index([materialVariantId])
  @@map("production_order_items")
}

// =============================================================================
// GOODS RECEIPT SYSTEM - GoodsReceipt, GoodsReceiptItem
// =============================================================================

// E1: Goods Receipt Note — the formal record of a specific physical delivery event.
// One Purchase can have multiple GRNs (partial deliveries).
// Inventory is only credited when a GRN transitions PENDING → CONFIRMED.
model GoodsReceipt {
  id         String             @id @default(cuid())
  purchaseId String
  purchase   Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  status     GoodsReceiptStatus @default(PENDING)
  notes      String?

  receivedById String
  receivedBy   User   @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id])

  items GoodsReceiptItem[]

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([businessId, branchId, purchaseId])
  @@index([status])
  @@map("goods_receipts")
}

// E2: Per-line quantities for a GRN. Supports partial receipts and discrepancy recording.
// orderedQty  — quantity on the original PO line item
// receivedQty — quantity physically counted at the time of receipt
// Discrepancy = orderedQty - receivedQty (positive = short delivery)
model GoodsReceiptItem {
  id        String       @id @default(cuid())
  receiptId String
  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  purchaseItemId String
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  unitId         String
  unit           Unit           @relation(fields: [unitId], references: [id])

  orderedQty  Float // Quantity on the original PO line
  receivedQty Float // Quantity physically counted at receipt time
  unitCost    Int // Cost per unit at time of receipt (carries over from PO, may be adjusted)

  discrepancyNotes String? // Explanation if receivedQty != orderedQty

  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  @@index([receiptId])
  @@index([businessId, branchId])
  @@map("goods_receipt_items")
}

// =============================================================================
// COMPOSABLE PRICING ENGINE - Phase 5
// =============================================================================

// ---------------------------------------------------------------------------
// PricingCatalog — Phase 5a
// A versioned snapshot of all feature prices at a point in time.
// Creating a new catalog version lets the platform update prices without
// retroactively changing grandfathered subscriptions.
// ---------------------------------------------------------------------------
model PricingCatalog {
  id          String        @id @default(cuid())
  version     Int           @unique // Monotonically increasing version number (v1, v2, …)
  label       String // Human-readable label (e.g. "2026 Standard Pricing")
  status      CatalogStatus @default(DRAFT)
  activatedAt DateTime? // When the catalog became ACTIVE
  archivedAt  DateTime? // When the catalog was superseded

  featurePrices  FeaturePrice[]
  bundleVersions FeatureBundleVersion[]
  pricingQuotes  PricingQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("pricing_catalogs")
}

// ---------------------------------------------------------------------------
// FeaturePrice — Phase 5a
// Per-feature monthly price within a specific PricingCatalog version.
// One row per (catalogId, featureKey) pair.
// Decoupled from the Feature model so prices can change between catalog versions
// without touching the Feature registry.
// ---------------------------------------------------------------------------
model FeaturePrice {
  id         String         @id @default(cuid())
  catalogId  String
  catalog    PricingCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  featureKey String
  feature    Feature        @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  // Pricing
  monthlyPrice     Int // In cents. 0 = included at no extra charge.
  annualPrice      Int? // Optional annual price override (cents). Null = use monthlyPrice × 12.
  isIncludedInBase Boolean @default(false) // true = no charge even in a composable subscription

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([catalogId, featureKey])
  @@index([catalogId])
  @@map("feature_prices")
}

// ---------------------------------------------------------------------------
// FeatureDependency — Phase 5a
// Directed dependency edge: if a business selects `featureKey`, the engine
// automatically adds `dependsOnKey` to the selection.
//
// Cycle detection is performed by PricingEngine.validateDependencies() on every
// quote calculation. The entitlements seeder validates the graph post-seed.
// ---------------------------------------------------------------------------
model FeatureDependency {
  id           String  @id @default(cuid())
  featureKey   String
  feature      Feature @relation("FeatureDependencies", fields: [featureKey], references: [key], onDelete: Cascade)
  dependsOnKey String
  dependsOn    Feature @relation("FeatureDependents", fields: [dependsOnKey], references: [key], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([featureKey, dependsOnKey])
  @@index([featureKey])
  @@map("feature_dependencies")
}

// ---------------------------------------------------------------------------
// FeatureBundle — Phase 5a
// A named bundle of features that qualifies for a group discount.
// The bundle itself is versioned via FeatureBundleVersion so the composition
// and discount can change across catalog versions.
// ---------------------------------------------------------------------------
model FeatureBundle {
  id          String  @id @default(cuid())
  key         String  @unique // Stable identifier (e.g. "CORE_OPS_BUNDLE")
  label       String // Human-readable name (e.g. "Core Operations Bundle")
  description String?
  isActive    Boolean @default(true)

  versions FeatureBundleVersion[]
  items    FeatureBundleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feature_bundles")
}

// ---------------------------------------------------------------------------
// FeatureBundleItem — Phase 5a
// The features that make up a bundle. A feature may belong to multiple bundles.
// ---------------------------------------------------------------------------
model FeatureBundleItem {
  id         String        @id @default(cuid())
  bundleId   String
  bundle     FeatureBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  featureKey String
  feature    Feature       @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([bundleId, featureKey])
  @@index([bundleId])
  @@map("feature_bundle_items")
}

// ---------------------------------------------------------------------------
// FeatureBundleVersion — Phase 5a
// The discount terms for a bundle within a specific PricingCatalog version.
// Allows bundle discounts to change when a new catalog is published.
// ---------------------------------------------------------------------------
model FeatureBundleVersion {
  id        String         @id @default(cuid())
  bundleId  String
  bundle    FeatureBundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  catalogId String
  catalog   PricingCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  pricingType   BundlePricingType
  discountValue Int // Interpretation depends on pricingType:
  //   PERCENTAGE_DISCOUNT → basis points (e.g. 1500 = 15%)
  //   FIXED_PRICE         → total price in cents
  //   FLAT_DISCOUNT       → amount deducted in cents

  // Minimum number of bundle items the selection must include for the bundle
  // to qualify. Defaults to the full bundle item count (all-or-nothing).
  minimumItems Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bundleId, catalogId])
  @@index([catalogId])
  @@map("feature_bundle_versions")
}

// ---------------------------------------------------------------------------
// PricingQuote — Phase 5a
// A versioned pricing proposal generated by PricingEngine for a business.
// Lifecycle: DRAFT → CALCULATED → SENT → ACCEPTED → CONVERTED
//                                              ↓ EXPIRED / CANCELLED
// ---------------------------------------------------------------------------
model PricingQuote {
  id         String @id @default(cuid())
  businessId String

  // The catalog version used when this quote was calculated.
  catalogId String
  catalog   PricingCatalog @relation(fields: [catalogId], references: [id])

  status QuoteStatus @default(DRAFT)

  // Totals (cents) — populated by PricingEngine.generateQuote()
  subtotalMonthly Int @default(0) // Sum of feature prices (pre-discount, per month)
  discountAmount  Int @default(0) // Total discount (bundle + promo, per month)
  taxAmount       Int @default(0) // Tax (per month)
  grandTotal      Int @default(0) // Monthly recurring total (excl. one-time fees)

  annualTotal   Int? // Annual equivalent (grandTotal × 12 - annual savings), if applicable
  annualSavings Int? // How much cheaper the annual option is vs 12× monthly

  oneTimeFees Int @default(0) // Sum of ONE_TIME_FEE lines (shown separately)

  // Validity window
  validUntil DateTime? // Quote expires after this date if not accepted

  // Who generated this quote
  generatedBy String? // userId or "system"

  // Optional negotiated note (for enterprise/partner quotes)
  notes String? @db.Text

  items PricingQuoteItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime?
  convertedAt DateTime?
  expiredAt   DateTime?
  cancelledAt DateTime?

  @@index([businessId, status])
  @@index([status, validUntil])
  @@map("pricing_quotes")
}

// ---------------------------------------------------------------------------
// PricingQuoteItem — Phase 5a
// A single line item on a PricingQuote.
// ---------------------------------------------------------------------------
model PricingQuoteItem {
  id      String       @id @default(cuid())
  quoteId String
  quote   PricingQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  lineType    QuoteLineType
  featureKey  String? // Null for BUNDLE_DISCOUNT, PROMO_DISCOUNT, TAX, SURCHARGE lines
  description String

  // For FEATURE lines: unitAmount = FeaturePrice.monthlyPrice; quantity = 1 (monthly) or 12 (annual)
  // For discount lines: unitAmount is negative; quantity = 1
  quantity   Int
  unitAmount Int // Cents. Negative for discount lines.
  lineAmount Int // quantity × unitAmount (pre-computed for audit stability)

  // Optional negotiated price override (enterprise/partner quotes).
  // When set, this overrides unitAmount for the final total calculation.
  negotiatedPrice Int?

  sortOrder Int @default(0) // Display ordering within the quote

  @@index([quoteId])
  @@map("pricing_quote_items")
}

// ============================================================================
// COUNTRY-SPECIFIC STANDALONE MODELS: PH
// ============================================================================

model PhilippinesCompliance {
  id String @id @default(cuid())

  // BIR requirements
  birTin         String // Tax Identification Number
  birPtuNumber   String? // Permit to Use
  birPtuIssuedAt DateTime? // PTU issue date
  birRdoCode     String? // Revenue District Office

  // Business registration
  secRegistration     String? // SEC registration
  mayorPermit         String? // Mayor's permit
  dtiRegistration     String? // DTI registration
  vatRegistrationDate DateTime?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("philippines_compliance")
}

model PhilippinesBranchCompliance {
  id String @id @default(cuid())

  // BIR branch requirements
  branchSerialNumber String // BIR-issued serial number
  branchCode         String // Branch suffix "00001"
  ptuNumber          String? // Branch-specific PTU
  rdoCode            String? // RDO for this branch
  mayorPermit        String? // Branch permit

  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("philippines_branch_compliance")
}
