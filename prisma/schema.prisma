// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- MULTI TENANCY ---
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Global to the Business
  members    Membership[]
  branches   Branch[]
  products   Product[]
  categories Category[]
  units      Unit[]
  customers  Customer[]

  @@map("organizations")
}

model Membership {
  id   String @id @default(cuid())
  role Role   @default(CASHIER)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Link a staff member to a specific "Home" branch
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Branch {
  id      String  @id @default(cuid())
  name    String
  address String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Branch-specific data
  members      Membership[]
  inventory    Inventory[]
  transactions Transaction[]
  movements    InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

// --- USER & ROLE MANAGEMENT ---
enum Role {
  ADMIN
  SUPERVISOR
  CASHIER
  SERVICE_PROVIDER // Doctor, Barber, Therapist, Housekeeping
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean
  image         String?
  role          Role    @default(CASHIER)

  // Auth relations
  sessions Session[]
  accounts Account[]

  // Transactions handled as a Staff member
  processedSales    Transaction[] @relation("CashierRelation")
  performedServices Transaction[] @relation("ServiceProvider")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  memberships        Membership[]

  @@map("users")
}

// --- AUTH SYSTEM ---

// Need for better auth management, but can be extended for other purposes like tracking user sessions, devices, etc.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  branchId       String

  @@map("sessions")
}

// Need for better auth management, but can be extended for other purposes like tracking user accounts, providers, etc.
model Account {
  id         String   @id @default(cuid())
  accountId  String
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  password   String?
  createdAt  DateTime
  updatedAt  DateTime

  @@map("accounts")
}

// --- PRODUCT & RESOURCE ENGINE ---
enum ResourceType {
  PHYSICAL_GOOD // Grocery, Hardware, Medicine
  SERVICE // Room Stay, Consultation, Haircut
  RAW_MATERIAL // Ingredients, Wood (Inventory only)
  BUNDLE // Meal Kit, Gift Basket, Promo Pack
}

model Category {
  id             String       @id @default(cuid())
  name           String       @unique
  products       Product[]
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  @@map("categories")
}

model Product {
  id    String       @id @default(cuid())
  name  String
  image String?
  sku   String?      @unique // Barcode/Universal Product Code
  type  ResourceType @default(PHYSICAL_GOOD)
  price Decimal      @db.Decimal(10, 2)

  // Business Specific Flags
  isAvailable     Boolean  @default(true)
  hasExpiry       Boolean  @default(false) // Pharmacy/Food
  requiresDeposit Boolean  @default(false) // LPG/Water/Bottles
  depositAmount   Decimal? @db.Decimal(10, 2)
  durationMinutes Int? // Service duration (Clinic/Spa)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  baseUnitId String
  baseUnit   Unit   @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])

  // --- THE VARIANT SYSTEM ---
  // If this is null, it's a "Master" or "Standalone" product.
  // If this has an ID, this product is a variant of another product.
  variantOfId  String?
  variantOf    Product?  @relation("ProductVariants", fields: [variantOfId], references: [id])
  variants     Product[] @relation("ProductVariants")
  variantType  String? // e.g., "Color-Size" or "Material"
  variantValue String? // e.g., "Red-XL" or "Stainless"

  // Self-referencing relationship for Recipes/Bundles
  // (e.g., A "Burger" consumes "Beef Patty")
  ingredients ProductIngredient[] @relation("ParentProduct")
  usedIn      ProductIngredient[] @relation("ComponentItem")

  allowedAddons ProductAddon[] @relation("HostProduct")
  usedAsAddonIn ProductAddon[] @relation("AddonComponent")

  inventory  Inventory[]
  orderItems OrderItem[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  orderItemAddons    OrderItemAddon[]    @relation("AddonToOrderItem")
  productUnits       ProductUnit[]
  organization       Organization        @relation(fields: [organizationId], references: [id])
  organizationId     String

  @@map("products")
}

model ProductIngredient {
  id           String  @id @default(cuid())
  hostId       String
  materialId   String
  unitId       String
  quantityUsed Decimal @db.Decimal(10, 3)

  unit     Unit    @relation(fields: [unitId], references: [id])
  host     Product @relation("ParentProduct", fields: [hostId], references: [id])
  material Product @relation("ComponentItem", fields: [materialId], references: [id])

  @@unique([hostId, materialId])
  @@map("product_ingredients")
}

model ProductAddon {
  id              String  @id @default(cuid())
  hostId          String
  addonId         String
  priceOverride   Decimal @db.Decimal(10, 2)
  defaultQuantity Decimal @default(1) @db.Decimal(10, 3)

  host  Product @relation("HostProduct", fields: [hostId], references: [id])
  addon Product @relation("AddonComponent", fields: [addonId], references: [id])

  @@unique([hostId, addonId])
  @@map("product_addons")
}

enum UnitType {
  WEIGHT // kg, g, lbs, oz
  VOLUME // L, ml, fl-oz (Liquid)
  VOLUME_DRY // Bushel, Cup (Dry measurement)
  LENGTH // m, cm, ft, in
  AREA // sq-m, sq-ft (Flooring, Roofing, Fabric)
  COUNT // pcs, box, pack, dozen
  TIME // min, hour, day
}

model Unit {
  id           String   @id @default(cuid())
  name         String   @unique // e.g., "Kilogram"
  abbreviation String   @unique // e.g., "kg"
  type         UnitType

  // For future-proofing: Base Conversion
  // Example: If 'Gram' is the base, 'Kilogram' has factor 1000
  conversionFactor Decimal @default(1) @db.Decimal(12, 4)
  isBaseUnit       Boolean @default(false)

  products           Product[]           @relation("ProductBaseUnit")
  ingredients        ProductIngredient[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  productUnits       ProductUnit[]
  organization       Organization        @relation(fields: [organizationId], references: [id])
  organizationId     String

  @@map("units")
}

model ProductUnit {
  id        String @id @default(cuid())
  productId String
  unitId    String

  // Is this the unit the supplier uses?
  isPurchaseUnit Boolean @default(false)

  // Is this the unit shown on the POS?
  isSalesUnit Boolean @default(true)

  product Product @relation(fields: [productId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@map("product_units")
}

// --- INVENTORY & BATCH TRACKING ---
enum MovementType {
  IN // Restock, Purchase
  OUT // Sale, Usage
  ADJUST // Manual Correction
  WASTE // Damage, Expiry
}

model Inventory {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  unitId String // The unit this specific batch is stored in
  unit   Unit   @relation(fields: [unitId], references: [id])

  batchNumber String? // Lot # for Drugstore/Medicine
  expiryDate  DateTime?
  quantity    Decimal   @db.Decimal(10, 3) // Supports kg, L, units
  location    String? // Warehouse A, Aisle 4, Room 101

  lastRestocked DateTime @default(now())
  branch        Branch   @relation(fields: [branchId], references: [id])
  branchId      String

  @@map("inventory")
}

// This allows you to generate the "Inventory Reports" we built earlier
model InventoryMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  type     MovementType
  quantity Decimal      @db.Decimal(10, 3) // Positive for IN, Negative for OUT
  reason   String? // "Sold in INV-102", "Expired", "Manual Restock"

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  String

  @@map("inventory_movements")
}

// --- CUSTOMER / PATIENT RECORDS ---
model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String?   @unique
  phone       String?
  dateOfBirth DateTime? // For Clinics/Age-restricted items

  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String

  @@map("customers")
}

// --- TRANSACTIONS & SALES ---
enum TransactionType {
  SALE
  REFUND
  BOOKING // Hotel/Resort/Clinic Appointment
  ADJUSTMENT // Waste/Loss
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  CHECKED_IN
}

model Transaction {
  id        String            @id @default(cuid())
  invoiceNo String            @unique @default(cuid())
  type      TransactionType   @default(SALE)
  status    TransactionStatus @default(COMPLETED)

  totalAmount Decimal @db.Decimal(10, 2)
  taxAmount   Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)

  // Timing (Hotels/Resorts/Appointments)
  startTime DateTime?
  endTime   DateTime?

  // Contextual Data
  notes       String? @db.Text // Clinical notes, room requests, etc.
  queueNumber Int?    @default(autoincrement())

  // Relationships
  cashierId String
  cashier   User   @relation("CashierRelation", fields: [cashierId], references: [id])

  providerId String? // The Doctor, Barber, or Server
  provider   User?   @relation("ServiceProvider", fields: [providerId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items     OrderItem[]
  createdAt DateTime    @default(now())
  branch    Branch      @relation(fields: [branchId], references: [id])
  branchId  String

  @@map("transactions")
}

model OrderItem {
  id        String  @id @default(cuid())
  productId String // The Main Product (e.g., Ramen)
  quantity  Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 2) // Price of the Ramen itself

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  // This is where we track the EXTRA revenue
  selectedAddons OrderItemAddon[]

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  addonId String // The "Fried Egg" Product ID
  addon   Product @relation("AddonToOrderItem", fields: [addonId], references: [id])

  quantity    Decimal @db.Decimal(10, 3)
  priceAtSale Decimal @db.Decimal(10, 2) // The $1.50 revenue for the egg

  @@map("order_item_addons")
}
