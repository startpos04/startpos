// --- PRISMA CONFIG ---

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VatType {
  VAT
  NON_VAT
}

// --- MULTI TENANCY ---
model Organization {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  logo String?

  tin               String?
  businessStyle     String?
  vatType           VatType @default(VAT) // VAT or NON_VAT
  permitToUse       String? // BIR PTU number
  accreditedPrinter String? // BIR Accredited Printer number

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Global to the Business
  members    Membership[]
  branches   Branch[]
  products   Product[]
  categories Category[]
  units      Unit[]
  customers  Customer[]

  @@index([deletedAt])
  @@map("organizations")
}

model Branch {
  id      String  @id @default(cuid())
  name    String
  address String?

  serialNumber String? // SN (printed receipts requirement)
  minInvoiceNo Int? // for OR range tracking
  maxInvoiceNo Int?

  bufferRate Int     @default(20) // Percentage markup for profit calculations (e.g., 20 for 20%)
  locale     String? // For future localization needs (e.g., "en-US", "fr-FR")
  currency   String? // For future multi-currency support (e.g., "USD", "EUR")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members           Membership[]
  inventory         Inventory[]
  transactions      Transaction[]
  movements         InventoryMovement[] @relation("SourceBranch")
  receivedTransfers InventoryMovement[] @relation("DestinationBranch") // Track stock coming INTO this branch from another
  purchases         Purchase[]
  vendorSessions    VendorSession[]

  @@index([deletedAt])
  @@map("branches")
}

model Membership {
  id   String @id @default(cuid())
  role Role   @default(CASHIER)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Link a staff member to a specific "Home" branch
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, organizationId])
  @@index([deletedAt])
  @@map("memberships")
}

// --- USER & ROLE MANAGEMENT ---
enum Role {
  ADMIN
  SUPERVISOR
  CASHIER
  SERVICE_PROVIDER
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean
  image         String?
  role          Role    @default(CASHIER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions           Session[]
  accounts           Account[]
  processedSales     Transaction[]       @relation("CashierRelation")
  performedServices  Transaction[]       @relation("ServiceProvider")
  inventoryMovements InventoryMovement[]
  memberships        Membership[]
  vendorSessions     VendorSession[] // Link sessions to the user

  @@index([deletedAt])
  @@map("users")
}

// --- AUTH SYSTEM ---

// Need for better auth management, but can be extended for other purposes like tracking user sessions, devices, etc.
model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  branchId       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

// Need for better auth management, but can be extended for other purposes like tracking user accounts, providers, etc.
model Account {
  id         String  @id @default(cuid())
  accountId  String
  providerId String
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  password   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

// --- PRODUCT & RESOURCE ENGINE ---
enum ResourceType {
  PHYSICAL_GOOD // Grocery, Hardware, Medicine
  SERVICE // Room Stay, Consultation, Haircut
  RAW_MATERIAL // Ingredients, Wood (Inventory only)
  BUNDLE // Meal Kit, Gift Basket, Promo Pack
}

model Category {
  id             String @id @default(cuid())
  name           String @unique
  organizationId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products     Product[]
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id        String       @id @default(cuid())
  name      String
  image     String?
  sku       String?      @unique // Barcode/Universal Product Code
  type      ResourceType @default(PHYSICAL_GOOD)
  price     Int          @db.Integer // Price charged to customers (in cents to avoid float issues)
  costPrice Int          @default(0) @db.Integer // Cost to acquire/make the product (in cents)

  // Business Specific Flags
  isAvailable     Boolean @default(true)
  hasExpiry       Boolean @default(false) // Pharmacy/Food
  requiresDeposit Boolean @default(false) // LPG/Water/Bottles
  depositAmount   Int?    @db.Integer // Deposit amount if requiresDeposit is true (in cents)
  durationMinutes Int? // Service duration (Clinic/Spa)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  baseUnitId String
  baseUnit   Unit   @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])

  // --- THE VARIANT SYSTEM ---
  // If this is null, it's a "Master" or "Standalone" product.
  // If this has an ID, this product is a variant of another product.
  variantOfId  String?
  variantOf    Product?  @relation("ProductVariants", fields: [variantOfId], references: [id])
  variants     Product[] @relation("ProductVariants")
  variantType  String? // e.g., "Color-Size" or "Material"
  variantValue String? // e.g., "Red-XL" or "Stainless"

  // Self-referencing relationship for Recipes/Bundles
  // (e.g., A "Burger" consumes "Beef Patty")
  ingredients ProductIngredient[] @relation("ParentProduct")
  usedIn      ProductIngredient[] @relation("ComponentItem")

  allowedAddons ProductAddon[] @relation("HostProduct")
  usedAsAddonIn ProductAddon[] @relation("AddonComponent")

  inventory          Inventory[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  orderItemAddons    OrderItemAddon[]    @relation("AddonToOrderItem")
  productUnits       ProductUnit[]
  purchaseItems      PurchaseItem[]

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("products")
}

model ProductIngredient {
  id           String @id @default(cuid())
  hostId       String
  materialId   String
  unitId       String
  quantityUsed Float // How much of the material is used in the host product (e.g., 0.25 kg of Beef in a Burger)

  unit     Unit    @relation(fields: [unitId], references: [id])
  host     Product @relation("ParentProduct", fields: [hostId], references: [id])
  material Product @relation("ComponentItem", fields: [materialId], references: [id])

  @@unique([hostId, materialId])
  @@map("product_ingredients")
}

model ProductAddon {
  id              String @id @default(cuid())
  hostId          String
  addonId         String
  priceOverride   Int // If the addon has a different price than its standalone price (in cents)
  defaultQuantity Float  @default(1) // Default quantity of the addon when added to the host product

  host  Product @relation("HostProduct", fields: [hostId], references: [id])
  addon Product @relation("AddonComponent", fields: [addonId], references: [id])

  @@unique([hostId, addonId])
  @@map("product_addons")
}

enum UnitType {
  WEIGHT // kg, g, lbs, oz
  VOLUME // L, ml, fl-oz (Liquid)
  VOLUME_DRY // Bushel, Cup (Dry measurement)
  LENGTH // m, cm, ft, in
  AREA // sq-m, sq-ft (Flooring, Roofing, Fabric)
  COUNT // pcs, box, pack, dozen
  TIME // min, hour, day
}

model Unit {
  id           String   @id @default(cuid())
  name         String   @unique
  abbreviation String   @unique
  type         UnitType

  conversionFactor Float   @default(1)
  isBaseUnit       Boolean @default(false)
  organizationId   String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization        @relation(fields: [organizationId], references: [id])
  products      Product[]           @relation("ProductBaseUnit")
  ingredients   ProductIngredient[]
  inventory     Inventory[]
  movements     InventoryMovement[]
  orderItems    OrderItem[]
  productUnits  ProductUnit[]
  purchaseItems PurchaseItem[]

  @@index([deletedAt])
  @@map("units")
}

model ProductUnit {
  id        String @id @default(cuid())
  productId String
  unitId    String

  // Is this the unit the supplier uses?
  isPurchaseUnit Boolean @default(false)

  // Is this the unit shown on the POS?
  isSalesUnit Boolean @default(true)

  product Product @relation(fields: [productId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@map("product_units")
}

// --- PURCHASING (EXPENDITURE TRACKING) ---
model Purchase {
  id         String  @id @default(cuid())
  sourceName String? // e.g. "Wholesale Mart", "Vendor X"
  totalCost  Int // Total cost of the purchase (in cents)
  notes      String?
  branchId   String
  branch     Branch  @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  unitCost   Int

  @@map("purchase_items")
}

// --- INVENTORY & BATCH TRACKING ---
enum MovementType {
  IN // Restock, Purchase
  OUT // Sale, Usage
  ADJUST // Manual Correction
  WASTE // Damage, Expiry
  TRANSFER // Movement between branches (Main Kitchen to Cart)
}

model Inventory {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  unitId      String // The unit this specific batch is stored in
  unit        Unit      @relation(fields: [unitId], references: [id])
  batchNumber String? // Lot # for Drugstore/Medicine
  expiryDate  DateTime?
  quantity    Float // Current quantity in stock for this batch (e.g., 100.5 kg, 50 units)

  // Track cost per batch for accurate profit reporting
  costPrice Int @default(0) // Cost per unit (in cents) for this specific batch

  location String? // Warehouse A, Aisle 4, Room 101

  lastRestocked DateTime @default(now())
  branch        Branch   @relation(fields: [branchId], references: [id])
  branchId      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory")
}

model InventoryMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      MovementType
  quantity  Float // How much was moved in or out (e.g., 10 kg, 5 units)
  reason    String? // "Sold in INV-102", "Expired", "Manual Restock"
  unitId    String
  unit      Unit         @relation(fields: [unitId], references: [id])

  branchId String
  branch   Branch @relation("SourceBranch", fields: [branchId], references: [id])

  // Destination branch for transfers
  targetBranchId String?
  targetBranch   Branch? @relation("DestinationBranch", fields: [targetBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_movements")
}

// --- CUSTOMER RECORDS ---
model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String?   @unique
  phone       String?
  dateOfBirth DateTime? // For Clinics/Age-restricted items

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transactions Transaction[]

  @@index([deletedAt])
  @@map("customers")
}

// --- TRANSACTIONS & SALES ---
enum TransactionType {
  SALE
  REFUND
  BOOKING // Hotel/Resort/Clinic Appointment
  ADJUSTMENT // Waste/Loss
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  CHECKED_IN
}

model Transaction {
  id        String            @id @default(cuid())
  invoiceNo String            @unique @default(cuid())
  type      TransactionType   @default(SALE)
  status    TransactionStatus @default(COMPLETED)

  // --- REVENUE VS COST (Line Graph Source) ---
  totalAmount Int // Total charged to the customer (in cents)
  totalCost   Int // Total cost of goods/services sold (in cents), calculated from OrderItems at time of sale
  bufferRate  Int // Snapshot of Branch buffer rate at time of transaction for profit analysis

  taxAmount Int // Tax amount (in cents)
  discount  Int @default(0) // Discount amount (in cents)

  // Timing (Hotels/Resorts/Appointments)
  startTime DateTime?
  endTime   DateTime?

  // Contextual Data
  notes       String? @db.Text // Clinical notes, room requests, etc.
  queueNumber Int?    @default(autoincrement())

  // Relationships
  cashierId String
  cashier   User   @relation("CashierRelation", fields: [cashierId], references: [id])

  providerId String? // The Doctor, Barber, or Server
  provider   User?   @relation("ServiceProvider", fields: [providerId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id])

  // Link to a daily session for reconciling evening sales
  sessionId String?
  session   VendorSession? @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@map("transactions")
}

model OrderItem {
  id        String @id @default(cuid())
  productId String
  quantity  Float // Supports kg, L, units

  // Snapshots for Profit Analysis
  unitPrice Int // Price charged to customer per unit (in cents) at time of sale
  unitCost  Int @default(0) // Cost per unit (in cents) at time of sale, calculated from Product costPrice + Branch buffer

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  selectedAddons OrderItemAddon[]
  transactionId  String
  transaction    Transaction      @relation(fields: [transactionId], references: [id])
  product        Product          @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  addonId     String // The "Fried Egg" Product ID
  addon       Product @relation("AddonToOrderItem", fields: [addonId], references: [id])
  quantity    Float // How much was added (e.g., 2 units)
  priceAtSale Int // Price charged for this addon at time of sale (in cents)
  costAtSale  Int     @default(0) // Cost of this addon at time of sale (in cents)

  @@map("order_item_addons")
}

// --- VENDOR SESSION SYSTEM ---
// Added for tracking when a street food seller goes out and returns for reconciliation.
enum SessionStatus {
  OPEN
  CLOSED
}

model VendorSession {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  startTime DateTime  @default(now())
  endTime   DateTime?

  openingCash Int  @default(0) // In cents (starting change fund)
  closingCash Int? // In cents (actual cash brought back)

  status SessionStatus @default(OPEN)
  notes  String?

  transactions Transaction[]

  @@map("vendor_sessions")
}
