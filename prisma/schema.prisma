// --- PRISMA CONFIG ---

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VatType {
  VAT
  NON_VAT
}

// --- MULTI TENANCY ---
model Organization {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  logo String?

  tin               String?
  businessStyle     String?
  vatType           VatType @default(VAT)
  permitToUse       String? // BIR PTU number
  accreditedPrinter String? // BIR Accredited Printer number

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members            Membership[]
  branches           Branch[]
  products           Product[]
  categories         Category[]
  units              Unit[]
  customers          Customer[]
  productComponents  ProductComponent[]
  productUnits       ProductUnit[]
  purchaseItems      PurchaseItem[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  transactions       Transaction[]
  orders             Order[]
  orderItems         OrderItem[]
  orderItemAddons    OrderItemAddon[]
  vendorSessions     VendorSession[]
  payments           Payment[]
  variants           ProductVariant[]

  @@index([deletedAt])
  @@map("organizations")
}

model Branch {
  id      String  @id @default(cuid())
  name    String
  address String?

  serialNumber String? // SN (printed receipts requirement)
  minInvoiceNo Int? // for OR range tracking
  maxInvoiceNo Int?

  bufferRate Int     @default(20) // Percentage markup for profit calculations (e.g., 20 for 20%)
  locale     String? // For future localization needs (e.g., "en-US", "fr-FR")
  currency   String? // For future multi-currency support (e.g., "USD", "EUR")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members           Membership[]
  inventory         Inventory[]
  transactions      Transaction[]
  orders            Order[] // Added for Branch-level orders
  movements         InventoryMovement[] @relation("SourceBranch")
  receivedTransfers InventoryMovement[] @relation("DestinationBranch")
  purchases         Purchase[]
  vendorSessions    VendorSession[]
  purchaseItems     PurchaseItem[]
  orderItems        OrderItem[]
  orderItemAddons   OrderItemAddon[]
  payments          Payment[]

  @@index([deletedAt])
  @@map("branches")
}

model Membership {
  id   String @id @default(cuid())
  role Role   @default(CASHIER)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, organizationId])
  @@index([deletedAt])
  @@map("memberships")
}

// --- USER & ROLE MANAGEMENT ---
enum Role {
  ADMIN
  SUPERVISOR
  CASHIER
  SERVICE_PROVIDER
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean
  image         String?
  role          Role    @default(CASHIER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions           Session[]
  accounts           Account[]
  processedSales     Transaction[]       @relation("CashierRelation")
  performedServices  Transaction[]       @relation("ServiceProvider")
  inventoryMovements InventoryMovement[]
  memberships        Membership[]
  vendorSessions     VendorSession[]

  @@index([deletedAt])
  @@map("users")
}

// --- AUTH SYSTEM ---

// Need for better auth management, but can be extended for other purposes like tracking user sessions, devices, etc.
model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  branchId       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

// Need for better auth management, but can be extended for other purposes like tracking user accounts, providers, etc.
model Account {
  id         String  @id @default(cuid())
  accountId  String
  providerId String
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  password   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

// --- PRODUCT & RESOURCE ENGINE ---
enum ResourceType {
  PHYSICAL_GOOD
  SERVICE
  RAW_MATERIAL
  BUNDLE
}

model Category {
  id             String @id @default(cuid())
  name           String @unique
  organizationId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products     Product[]
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id              String       @id @default(cuid())
  name            String
  image           String?
  type            ResourceType @default(PHYSICAL_GOOD)
  // Business Specific Flags
  isAvailable     Boolean      @default(true)
  hasExpiry       Boolean      @default(false) // Pharmacy/Food
  requiresDeposit Boolean      @default(false) // LPG/Water/Bottles
  depositAmount   Int?         @db.Integer // Deposit amount if requiresDeposit is true (in cents)
  durationMinutes Int? // Service duration (Clinic/Spa)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  baseUnitId String
  baseUnit   Unit   @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])

  variants ProductVariant[]

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name        String?
  image       String?
  sku         String? @unique
  price       Int     @db.Integer // Price charged to customers (in cents to avoid float issues)
  costPrice   Int     @default(0) @db.Integer // Cost to acquire/make the product (in cents)
  variantType String?

  components ProductComponent[] @relation("ParentVariant")
  usedIn     ProductComponent[] @relation("ComponentVariant")

  inventory          Inventory[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  orderItemAddons    OrderItemAddon[]    @relation("AddonToOrderItem")
  productUnits       ProductUnit[]
  purchaseItems      PurchaseItem[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, productId])
  @@map("product_variants")
}

model ProductComponent {
  id           String @id @default(cuid())
  hostId       String
  materialId   String
  unitId       String
  quantityUsed Float // How much of the material is used

  // Behavior Flags
  isAddon       Boolean @default(false) // True if it's a paid extra, False if it's a recipe ingredient
  priceOverride Int?    @db.Integer // Price charged if isAddon is true (in cents)

  unit     Unit           @relation(fields: [unitId], references: [id])
  host     ProductVariant @relation("ParentVariant", fields: [hostId], references: [id])
  material ProductVariant @relation("ComponentVariant", fields: [materialId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([hostId, materialId, isAddon])
  @@index([organizationId])
  @@map("product_components")
}

enum UnitType {
  WEIGHT // kg, g, lbs, oz
  VOLUME // L, ml, fl-oz (Liquid)
  VOLUME_DRY // Bushel, Cup (Dry measurement)
  LENGTH // m, cm, ft, in
  AREA // sq-m, sq-ft (Flooring, Roofing, Fabric)
  COUNT // pcs, box, pack, dozen
  TIME // min, hour, day
}

model Unit {
  id           String   @id @default(cuid())
  name         String   @unique
  abbreviation String   @unique
  type         UnitType

  conversionFactor Float   @default(1)
  isBaseUnit       Boolean @default(false)
  organizationId   String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization        @relation(fields: [organizationId], references: [id])
  products      Product[]           @relation("ProductBaseUnit")
  components    ProductComponent[]
  inventory     Inventory[]
  movements     InventoryMovement[]
  orderItems    OrderItem[]
  productUnits  ProductUnit[]
  purchaseItems PurchaseItem[]

  @@index([deletedAt])
  @@map("units")
}

model ProductUnit {
  id             String  @id @default(cuid())
  variantId      String
  unitId         String
  isPurchaseUnit Boolean @default(false)
  isSalesUnit    Boolean @default(true)

  variant ProductVariant @relation(fields: [variantId], references: [id])
  unit    Unit           @relation(fields: [unitId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([variantId, unitId])
  @@index([organizationId])
  @@map("product_units")
}

// --- PURCHASING (EXPENDITURE TRACKING) ---
model Purchase {
  id         String  @id @default(cuid())
  sourceName String? // e.g. "Wholesale Mart", "Vendor X"
  totalCost  Int // Total cost of the purchase (in cents)
  notes      String?
  branchId   String
  branch     Branch  @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Float
  unitId     String
  unit       Unit           @relation(fields: [unitId], references: [id])
  unitCost   Int

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])

  @@index([organizationId, branchId])
  @@map("purchase_items")
}

// --- INVENTORY & BATCH TRACKING ---
enum MovementType {
  IN // Restock, Purchase
  OUT // Sale, Usage
  ADJUST // Manual Correction
  WASTE // Damage, Expiry
  TRANSFER // Movement between branches (Main Kitchen to Cart)
}

model Inventory {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  unitId      String
  unit        Unit           @relation(fields: [unitId], references: [id])
  batchNumber String?
  expiryDate  DateTime?
  quantity    Float
  costPrice   Int            @default(0) // Cost per unit (in cents) for this specific batch
  location    String?

  lastRestocked DateTime @default(now())
  branch        Branch   @relation(fields: [branchId], references: [id])
  branchId      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id])
  inventoryMovements InventoryMovement[] @relation("SourceInventory")

  @@index([organizationId, branchId])
  @@map("inventory")
}

model InventoryMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  type      MovementType
  quantity  Float
  reason    String?
  unitId    String
  unit      Unit           @relation(fields: [unitId], references: [id])

  inventoryId String
  inventory   Inventory @relation("SourceInventory", fields: [inventoryId], references: [id])

  branchId String
  branch   Branch @relation("SourceBranch", fields: [branchId], references: [id])

  targetBranchId String?
  targetBranch   Branch? @relation("DestinationBranch", fields: [targetBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, branchId])
  @@map("inventory_movements")
}

// --- CUSTOMER RECORDS ---
model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String?   @unique
  phone       String?
  dateOfBirth DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transactions Transaction[]

  @@index([deletedAt])
  @@map("customers")
}

// --- ORDERS (KITCHEN/TAB SYSTEM) ---
enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       Int         @default(autoincrement())
  customerReference String? // e.g., "Buzzer 10", "Table 4"
  status            OrderStatus @default(PREPARING)
  orderType         OrderType   @default(DINE_IN)

  transaction Transaction?

  items OrderItem[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, branchId])
  @@map("orders")
}

// --- TRANSACTIONS & SALES ---
enum TransactionType {
  SALE
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
}

model Transaction {
  id        String            @id @default(cuid())
  invoiceNo String            @unique @default(cuid())
  type      TransactionType   @default(SALE)
  status    TransactionStatus @default(COMPLETED)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  // --- REVENUE VS COST (Line Graph Source) ---
  totalAmount Int // Total charged to the customer (in cents)
  totalCost   Int // Total cost of goods/services sold (in cents)
  bufferRate  Int // Snapshot of Branch buffer rate at time of transaction

  taxAmount Int // Tax amount (in cents)
  discount  Int @default(0) // Discount amount (in cents)

  // Timing (Hotels/Resorts/Appointments)
  startTime DateTime?
  endTime   DateTime?

  // Contextual Data
  notes       String? @db.Text // Clinical notes, room requests, etc.
  queueNumber Int?    @default(autoincrement())

  cashierId  String
  cashier    User           @relation("CashierRelation", fields: [cashierId], references: [id])
  providerId String?
  provider   User?          @relation("ServiceProvider", fields: [providerId], references: [id])
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id])
  branchId   String
  branch     Branch         @relation(fields: [branchId], references: [id])
  sessionId  String?
  session    VendorSession? @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, branchId])
  @@map("transactions")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Float

  unitPrice Int
  unitCost  Int @default(0)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  selectedAddons OrderItemAddon[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])

  @@index([organizationId, branchId])
  @@map("order_items")
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  addonId     String // Points to a ProductVariant acting as addon
  addon       ProductVariant @relation("AddonToOrderItem", fields: [addonId], references: [id])
  quantity    Float // How much was added (e.g., 2 units)
  priceAtSale Int // Price charged for this addon at time of sale (in cents)
  costAtSale  Int            @default(0) // Cost of this addon at time of sale (in cents)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])

  @@index([organizationId, branchId])
  @@map("order_item_addons")
}

// --- VENDOR SESSION SYSTEM ---
// Added for tracking when a street food seller goes out and returns for reconciliation.
enum SessionStatus {
  OPEN
  CLOSED
}

model VendorSession {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  startTime   DateTime      @default(now())
  endTime     DateTime?
  openingCash Int           @default(0)
  closingCash Int?
  status      SessionStatus @default(OPEN)
  notes       String?

  transactions Transaction[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, branchId])
  @@map("vendor_sessions")
}

enum PaymentMethod {
  CASH
  E_WALLET
  CARD
  CREDIT
}

model Payment {
  id          String        @id @default(cuid())
  amount      Int // The actual amount applied to the bill
  tendered    Int // The raw amount handed over (for cash)
  change      Int // Tendered - amount
  method      PaymentMethod @default(CASH)
  referenceNo String? // Reference # for GCash/Maya/Cards

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])

  @@index([organizationId, branchId])
  @@map("payments")
}
