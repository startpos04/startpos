# =============================================================================
# APP-SPECIFIC ENVIRONMENT — apps/web
# Committed to git. Contains defaults for this app only.
# Override locally by creating .env.app.local (gitignored).
# Shared vars (POSTGRES_*) live in web/.env — do not duplicate them here.
# =============================================================================

BUILD_ID=2
CONSOLE_LOG=true

# --- App ---
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3200
NODE_ENV=development
DOCKER_DEV=true

CANONICAL_URL=http://localhost:3200
BETTER_AUTH_URL=http://localhost:3200
BETTER_AUTH_INTERNAL_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=

LOCAL_DB_NAME=my_app_storage

# --- Payment (Manual provider) ---
PAYMENT_PROVIDER_MANUAL_ENABLED=true
PAYMENT_PROVIDER_MANUAL_PAYMENT_METHOD=GCash
PAYMENT_PROVIDER_MANUAL_ACCOUNT_NAME=startPOS
PAYMENT_PROVIDER_MANUAL_ACCOUNT_NUMBER=09171234567

# --- Feature Flags ---
ENABLE_EMAIL_VERIFICATION=false

# --- Email ---
# Get your key from https://resend.com
RESEND_API_KEY=
EMAIL_FROM=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NOTE: VITE_ prefix required — Vite only exposes vars with this prefix to the browser.
VITE_STRIPE_PUBLIC_KEY=

# Plan Price IDs
STRIPE_PLAN_TRIAL_PRICE_ID=
STRIPE_PLAN_STARTER_PRICE_ID=
STRIPE_PLAN_GROWTH_PRICE_ID=
STRIPE_PLAN_PREMIUM_PRICE_ID=
STRIPE_PLAN_STARTER_ANNUAL_PRICE_ID=
STRIPE_PLAN_GROWTH_ANNUAL_PRICE_ID=
STRIPE_PLAN_PREMIUM_ANNUAL_PRICE_ID=

# Branch credit package Price IDs
STRIPE_BRANCH_CREDIT_10_PRICE_ID=
STRIPE_BRANCH_CREDIT_50_PRICE_ID=
STRIPE_BRANCH_CREDIT_100_PRICE_ID=
STRIPE_BRANCH_CREDIT_500_PRICE_ID=
STRIPE_BRANCH_CREDIT_1000_PRICE_ID=

# Credit package Price IDs
STRIPE_CREDIT_PKG_10_PRICE_ID=
STRIPE_CREDIT_PKG_50_PRICE_ID=
STRIPE_CREDIT_PKG_100_PRICE_ID=

# TX top-up addon Price IDs
STRIPE_TX_ADDON_500_PRICE_ID=
STRIPE_TX_ADDON_1000_PRICE_ID=
STRIPE_TX_ADDON_5000_PRICE_ID=

# Monthly recurring addon Price IDs
STRIPE_ADDON_ANALYTICS_PRICE_ID=
STRIPE_ADDON_API_PRICE_ID=
STRIPE_ADDON_BRANCH_PRICE_ID=
STRIPE_ADDON_EMPLOYEE_PRICE_ID=
STRIPE_ADDON_TX_RECURRING_500_PRICE_ID=
STRIPE_ADDON_TX_RECURRING_1000_PRICE_ID=
STRIPE_ADDON_TX_RECURRING_5000_PRICE_ID=

# --- Cron ---
CRON_SECRET=
