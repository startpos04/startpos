{
  "name": "@startpos/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000 --host 0.0.0.0",
    "dev:docker": "vite dev --port 3000 --host 0.0.0.0 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production pnpm run build && pnpm run preview",
    "type-check": "pnpm exec tsc --noEmit",
    "scan": "npx fallow",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:all": "pnpm coverage && pnpm coverage:integration",
    "pretest:e2e": "echo \"\n⚠️  REMINDER: E2E tests require production server running!\n   Run 'pnpm start' in another terminal first.\n\" && exit 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:clean": "powershell -Command \"Remove-Item -Path '__tests__/e2e/fixtures/.auth/*.json' -Force -ErrorAction SilentlyContinue ; Remove-Item -Path '__tests__/e2e/fixtures/.auth/debug-*.png' -Force -ErrorAction SilentlyContinue\" && playwright test",
    "type-coverage": "type-coverage --detail --at-least 95",
    "type-coverage:report": "type-coverage --detail --output-format json",
    "validate": "pnpm type-check && pnpm type-coverage && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.3.2",
    "@serwist/window": "^9.5.7",
    "@startpos/platform": "workspace:*",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/browser-db-sqlite-persistence": "^0.1.9",
    "@tanstack/db": "0.6.5",
    "@tanstack/query-db-collection": "^1.0.31",
    "@tanstack/react-db": "^0.1.78",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.91.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/react-store": "^0.9.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.20",
    "lodash": "^4.18.1",
    "lucide-react": "^0.564.0",
    "neverthrow": "^8.2.0",
    "next-themes": "^0.4.6",
    "numeral": "^2.0.6",
    "papaparse": "^5.5.3",
    "pg": "8.18.0",
    "print-js-updated": "^1.6.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^15.0.0",
    "react-easy-crop": "^5.5.6",
    "recharts": "^3.8.0",
    "resend": "^6.18.1",
    "shadcn": "^3.8.4",
    "sonner": "^2.0.7",
    "stripe": "22.4.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.58.2",
    "@serwist/build": "^9.5.7",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.2.0",
    "@types/lodash": "^4.17.24",
    "@types/numeral": "^2.0.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "8.11.11",
    "@types/react": "^19.2.0",
