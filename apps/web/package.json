    "fallow": "^2.88.0",
    "jimp": "^1.6.1",
    "jsdom": "^27.0.0",
    "nitro": "latest",
    "serwist": "^9.5.7",
    "tsx": "^4.21.0",
    "type-coverage": "^2.30.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
