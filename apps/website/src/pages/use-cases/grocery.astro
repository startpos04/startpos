---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FinalCTA from '../../components/sections/FinalCTA.astro'
import { APP_URL } from '../../constants'

const features = [
  {
    icon: '📱',
    title: 'Barcode scanning',
    description: 'Scan any barcode at checkout for instant product lookup. Supports USB and Bluetooth scanners — keep lines moving.',
  },
  {
    icon: '⚖️',
    title: 'Bulk & weighted items',
    description: 'Price by weight or volume. Set per-kilo and per-litre rates, enter the weight at checkout — total calculates instantly.',
  },
  {
    icon: '📅',
    title: 'Expiry date tracking',
    description: 'Every batch gets an expiry date. Get alerted before items expire so you can discount or remove them in time.',
  },
  {
    icon: '🔔',
    title: 'Low-stock alerts',
    description: 'Set thresholds per product. Get notified when stock drops below the minimum so you can reorder before you run out.',
  },
  {
    icon: '🚚',
    title: 'Purchase orders & receiving',
    description: 'Create POs, send to suppliers, and receive stock directly into inventory. Cost prices update automatically on receipt.',
  },
  {
    icon: '📊',
    title: 'Inventory reports',
    description: 'Know your current stock value, fast movers, slow movers, and near-expiry items — all from a single report.',
  },
]

const stats = [
  { value: 'Real-time', label: 'Stock visibility' },
  { value: 'Batch', label: 'Expiry tracking' },
  { value: '< 3s', label: 'Average checkout time with barcode' },
  { value: 'Multi-branch', label: 'Centralized inventory' },
]
---

<BaseLayout
  title="POS for Grocery Stores"
  description="Start POS for grocery — barcode scanning, bulk items, expiry date tracking, low-stock alerts, and purchase orders. Built for supermarkets and wet markets."
>

  <!-- Hero -->
  <section class="bg-slate-900 pt-16 pb-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.04)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    <div class="absolute top-1/2 -right-48 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl -translate-y-1/2"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold px-3 py-1.5 rounded-full mb-5">
            🏪 For Grocery
          </span>
          <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight mb-5">
            Fast checkout.<br />Tight inventory.<br />
            <span class="text-emerald-400">Full control.</span>
          </h1>
          <p class="text-slate-400 text-lg leading-relaxed mb-8">
            Scan barcodes, track expiry dates, manage bulk items, and always know what's on the shelf — Start POS keeps a grocery running lean.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={APP_URL} class="px-7 py-3.5 bg-emerald-500 text-white font-bold rounded-xl hover:bg-emerald-600 shadow-lg shadow-emerald-500/20 transition-all text-center">
              Start free trial
            </a>
            <a href="#grocery-features" class="px-7 py-3.5 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:border-slate-500 hover:text-white transition-all text-center">
              See features
            </a>
          </div>
        </div>

        <!-- Visual placeholder -->
        <div class="relative">
          <div class="bg-slate-800 rounded-2xl border border-slate-700 shadow-2xl aspect-video flex items-center justify-center">
            <div class="text-center p-8">
              <div class="text-6xl mb-4">🏪</div>
              <p class="text-sm text-slate-400 font-medium">[Screenshot: Grocery checkout with barcode scan]</p>
              <p class="text-xs text-slate-500 mt-1">Barcode scanning · bulk items · expiry tracking</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Business type chips -->
  <section class="bg-slate-50 border-y border-slate-200 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-slate-600 font-medium">
        {['Supermarkets', 'Mini-marts', 'Wet markets', 'Convenience stores', 'Co-ops', 'Sari-sari stores'].map(t => (
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="py-12 bg-white border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {stats.map((s) => (
          <div class="text-center reveal">
            <p class="text-2xl font-black text-emerald-500 mb-1">{s.value}</p>
            <p class="text-xs text-slate-500 font-medium">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="grocery-features" class="py-20 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12 reveal">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900">Built for the grocery floor</h2>
        <p class="mt-3 text-slate-500">Every feature a grocery actually needs — without the enterprise price tag.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {features.map((f, i) => (
          <div class:list={['bg-white rounded-2xl border border-slate-200 p-6 hover:border-emerald-200 hover:shadow-lg hover:shadow-emerald-500/5 transition-all reveal', `reveal-delay-${(i % 3) + 1}`]}>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-xl mb-4">{f.icon}</div>
            <h3 class="text-sm font-bold text-slate-900 mb-1.5">{f.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inventory callout -->
  <section class="py-20 bg-slate-900 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.03)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <div class="text-4xl mb-6">📅</div>
      <h2 class="text-3xl sm:text-4xl font-black text-white mb-4">
        Never sell expired product again
      </h2>
      <p class="text-slate-400 text-base leading-relaxed max-w-2xl mx-auto mb-8">
        Assign expiry dates when you receive stock. Start POS alerts you as items approach expiry so you can mark them down, run promotions, or pull them from shelves — before a customer complains.
      </p>
      <div class="inline-flex items-center gap-3 bg-slate-800 border border-slate-700 rounded-xl px-5 py-3">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="text-sm text-slate-300 font-medium">Batch #2024-11-03 · Expires in 3 days · 24 units remaining</span>
      </div>
    </div>
  </section>

  <!-- Pricing nudge -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <p class="text-slate-500 mb-2 text-sm">Inventory and expiry tracking available on Premium and above — starting at</p>
      <p class="text-5xl font-black text-slate-900 mb-1">₱799<span class="text-xl font-medium text-slate-400">/mo</span></p>
      <p class="text-slate-400 text-sm mb-6">or try everything free for 30 days</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={APP_URL} class="px-7 py-3.5 bg-emerald-500 text-white font-bold rounded-xl hover:bg-emerald-600 shadow-md transition-all">
          Start free trial
        </a>
        <a href="/pricing" class="px-7 py-3.5 border border-slate-200 text-slate-600 font-semibold rounded-xl hover:border-slate-300 transition-all">
          View all plans
        </a>
      </div>
    </div>
  </section>

  <FinalCTA />

</BaseLayout>
