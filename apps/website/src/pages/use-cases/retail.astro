---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FinalCTA from '../../components/sections/FinalCTA.astro'
import { APP_URL } from '../../constants'

const features = [
  {
    icon: '🏷️',
    title: 'Product catalogue with variants',
    description: 'Manage every SKU, size, colour, and variant in one place. Set individual prices and costs per variant.',
  },
  {
    icon: '📱',
    title: 'Barcode support',
    description: 'Scan barcodes at checkout for instant product lookup. Compatible with USB and Bluetooth scanners.',
  },
  {
    icon: '📦',
    title: 'Inventory tracking',
    description: 'Know exactly what\'s in stock — at each location — before a customer asks. Low-stock alerts included.',
  },
  {
    icon: '📊',
    title: 'Sales history & reports',
    description: 'See your best-selling products, daily sales trends, and gross profit — then export to CSV for your accountant.',
  },
  {
    icon: '👥',
    title: 'Multiple cashiers',
    description: 'Give each staff member their own login. Track who processed what, when. Cashier reports built in.',
  },
  {
    icon: '🧾',
    title: 'BIR-compliant receipts',
    description: 'Sequential invoice numbering, VAT computation, and receipt printing ready out of the box.',
  },
]

const workflow = [
  { step: '1', title: 'Customer picks item', desc: 'Cashier scans barcode or searches product name' },
  { step: '2', title: 'Cart builds up', desc: 'Add quantities, apply discounts, choose payment method' },
  { step: '3', title: 'Checkout', desc: 'Process cash, card, or e-wallet. Print or email receipt' },
  { step: '4', title: 'Inventory updates', desc: 'Stock count decrements automatically — no manual entry' },
]
---

<BaseLayout
  title="POS for Retail Shops"
  description="Start POS for retail — product catalogue with variants, barcode support, inventory tracking, and BIR-compliant receipts. Built for clothing, hardware, and general retail."
>

  <!-- Hero -->
  <section class="bg-slate-900 pt-16 pb-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.04)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    <div class="absolute top-1/2 -right-48 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl -translate-y-1/2"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold px-3 py-1.5 rounded-full mb-5">
            🛒 For Retail
          </span>
          <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight mb-5">
            Everything a retail shop needs.<br />
            <span class="text-emerald-400">Nothing it doesn't.</span>
          </h1>
          <p class="text-slate-400 text-lg leading-relaxed mb-8">
            From a single boutique to a multi-branch hardware store — Start POS gives you fast checkout, tight inventory, and the reports you need to grow.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={APP_URL} class="px-7 py-3.5 bg-emerald-500 text-white font-bold rounded-xl hover:bg-emerald-600 shadow-lg shadow-emerald-500/20 transition-all text-center">
              Start free trial
            </a>
            <a href="#retail-features" class="px-7 py-3.5 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:border-slate-500 hover:text-white transition-all text-center">
              See features
            </a>
          </div>
        </div>

        <!-- Visual placeholder -->
        <div class="relative">
          <div class="bg-slate-800 rounded-2xl border border-slate-700 shadow-2xl aspect-video flex items-center justify-center">
            <div class="text-center p-8">
              <div class="text-6xl mb-4">🛒</div>
              <p class="text-sm text-slate-400 font-medium">[Screenshot: Retail checkout screen]</p>
              <p class="text-xs text-slate-500 mt-1">Barcode scanning · product variants · fast checkout</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Use case-specific chips -->
  <section class="bg-slate-50 border-y border-slate-200 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-slate-600 font-medium">
        {['Clothing stores', 'Hardware shops', 'Electronics retail', 'Bookstores', 'Pharmacies', 'General merchandise'].map(t => (
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="retail-features" class="py-20 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12 reveal">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900">Built for the retail floor</h2>
        <p class="mt-3 text-slate-500">Every feature a retail operation actually uses — nothing you'll never touch.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {features.map((f, i) => (
          <div class:list={['bg-white rounded-2xl border border-slate-200 p-6 hover:border-emerald-200 hover:shadow-lg hover:shadow-emerald-500/5 transition-all reveal', `reveal-delay-${(i % 3) + 1}`]}>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-xl mb-4">{f.icon}</div>
            <h3 class="text-sm font-bold text-slate-900 mb-1.5">{f.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-20 sm:py-24 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12 reveal">
        <h2 class="text-3xl font-black text-slate-900">How a sale works</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {workflow.map((w, i) => (
          <div class:list={['reveal', `reveal-delay-${i + 1}`]}>
            <div class="bg-white rounded-2xl border border-slate-200 p-6 text-center h-full">
              <div class="w-10 h-10 rounded-full bg-emerald-500 text-white font-black text-lg flex items-center justify-center mx-auto mb-4">
                {w.step}
              </div>
              <h3 class="text-sm font-bold text-slate-900 mb-2">{w.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{w.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing nudge -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <p class="text-slate-500 mb-2 text-sm">Retail features are available on all plans — starting at</p>
      <p class="text-5xl font-black text-slate-900 mb-1">₱299<span class="text-xl font-medium text-slate-400">/mo</span></p>
      <p class="text-slate-400 text-sm mb-6">or try free for 30 days</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={APP_URL} class="px-7 py-3.5 bg-emerald-500 text-white font-bold rounded-xl hover:bg-emerald-600 shadow-md transition-all">
          Start free trial
        </a>
        <a href="/pricing" class="px-7 py-3.5 border border-slate-200 text-slate-600 font-semibold rounded-xl hover:border-slate-300 transition-all">
          View all plans
        </a>
      </div>
    </div>
  </section>

  <FinalCTA />

</BaseLayout>
