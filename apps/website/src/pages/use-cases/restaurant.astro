---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FinalCTA from '../../components/sections/FinalCTA.astro'
import { APP_URL } from '../../constants'

const features = [
  {
    icon: '📋',
    title: 'Order queue & kitchen display',
    description: 'Orders land in the kitchen the moment they\'re placed. Status flows: received → in progress → ready → served.',
  },
  {
    icon: '🪑',
    title: 'Dine-in / take-out / delivery',
    description: 'Tag every order with its type. Track table numbers, buzzers, or rider names — all from one screen.',
  },
  {
    icon: '➕',
    title: 'Add-ons & modifiers',
    description: 'Extra rice, no onions, upsize. Build modifier groups per product and let cashiers select them in one tap.',
  },
  {
    icon: '💳',
    title: 'Deposit & partial payments',
    description: 'Take a deposit upfront and settle the balance later. Perfect for reservations and catered events.',
  },
  {
    icon: '📦',
    title: 'Ingredient tracking',
    description: 'Track raw material usage per recipe. Know exactly how many portions you can serve before you run out.',
  },
  {
    icon: '📊',
    title: 'Sales reports by period',
    description: 'See your busiest hours, best-selling items, and revenue by shift — then export for your accountant.',
  },
]

const orderFlow = [
  { icon: '📝', title: 'Order taken', desc: 'Cashier enters order at POS or on mobile' },
  { icon: '🔔', title: 'Kitchen notified', desc: 'Order appears on kitchen display instantly' },
  { icon: '🍳', title: 'Prepared', desc: 'Staff marks items ready as they\'re completed' },
  { icon: '✅', title: 'Served & closed', desc: 'Bill settled, receipt printed, table cleared' },
]
---

<BaseLayout
  title="POS for Restaurants"
  description="Start POS for restaurants — order queue, kitchen display, dine-in/take-out/delivery, add-ons, deposit tracking. Built for cafes, quick-service, and full-service dining."
>

  <!-- Hero -->
  <section class="bg-slate-900 pt-16 pb-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.04)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    <div class="absolute top-1/2 -left-48 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl -translate-y-1/2"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold px-3 py-1.5 rounded-full mb-5">
            🍽 For Restaurants
          </span>
          <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight mb-5">
            From table to kitchen —<br />
            <span class="text-emerald-400">in one tap.</span>
          </h1>
          <p class="text-slate-400 text-lg leading-relaxed mb-8">
            Orders flow from the front to the kitchen without paper tickets or shouting. Start POS keeps your service fast, your kitchen informed, and your numbers clean.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={APP_URL} class="px-7 py-3.5 bg-emerald-500 text-white font-bold rounded-xl hover:bg-emerald-600 shadow-lg shadow-emerald-500/20 transition-all text-center">
              Start free trial
            </a>
            <a href="#restaurant-features" class="px-7 py-3.5 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:border-slate-500 hover:text-white transition-all text-center">
              See features
            </a>
          </div>
        </div>

        <!-- Visual placeholder -->
        <div class="relative">
          <div class="bg-slate-800 rounded-2xl border border-slate-700 shadow-2xl aspect-video flex items-center justify-center">
            <div class="text-center p-8">
              <div class="text-6xl mb-4">🍽</div>
              <p class="text-sm text-slate-400 font-medium">[Screenshot: Restaurant order queue and kitchen display]</p>
              <p class="text-xs text-slate-500 mt-1">Order queue · kitchen status · dine-in / take-out / delivery</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Business type chips -->
  <section class="bg-slate-50 border-y border-slate-200 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-slate-600 font-medium">
        {['Cafes', 'Fast food', 'Casual dining', 'Food stalls', 'Catering', 'Cloud kitchens'].map(t => (
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Order flow -->
  <section class="py-20 sm:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12 reveal">
        <h2 class="text-3xl font-black text-slate-900">How an order flows</h2>
        <p class="mt-3 text-slate-500 text-sm">From the front counter to the kitchen and back — in seconds.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {orderFlow.map((step, i) => (
          <div class:list={['reveal', `reveal-delay-${i + 1}`]}>
            <div class="bg-white rounded-2xl border border-slate-200 p-6 text-center h-full relative">
              <div class="text-4xl mb-4">{step.icon}</div>
              <h3 class="text-sm font-bold text-slate-900 mb-2">{step.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{step.desc}</p>
              {i < orderFlow.length - 1 && (
                <div class="hidden lg:block absolute top-1/2 -right-3 -translate-y-1/2 text-slate-300 text-lg z-10">→</div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section id="restaurant-features" class="py-20 sm:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12 reveal">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900">Built for food service</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {features.map((f, i) => (
          <div class:list={['bg-white rounded-2xl border border-slate-200 p-6 hover:border-emerald-200 hover:shadow-lg hover:shadow-emerald-500/5 transition-all reveal', `reveal-delay-${(i % 3) + 1}`]}>
            <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-xl mb-4">{f.icon}</div>
            <h3 class="text-sm font-bold text-slate-900 mb-1.5">{f.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing nudge -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <p class="text-slate-500 mb-2 text-sm">Restaurant features — orders, kitchen flow, add-ons — are included on all plans</p>
      <p class="text-5xl font-black text-slate-900 mb-1">₱299<span class="text-xl font-medium text-slate-400">/mo</span></p>
      <p class="text-slate-400 text-sm mb-6">or try free for 30 days</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={APP_URL} class="px-7 py-3.5 bg-emerald-500 text-white font-bold rounded-xl hover:bg-emerald-600 shadow-md transition-all">
          Start free trial
        </a>
        <a href="/pricing" class="px-7 py-3.5 border border-slate-200 text-slate-600 font-semibold rounded-xl hover:border-slate-300 transition-all">
          View all plans
        </a>
      </div>
    </div>
  </section>

  <FinalCTA />

</BaseLayout>
