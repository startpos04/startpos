---
import BaseLayout from '../layouts/BaseLayout.astro'
import PlanCard from '../components/ui/PlanCard.astro'
import Accordion from '../components/ui/Accordion.astro'
import FinalCTA from '../components/sections/FinalCTA.astro'
import { PLANS, ADDONS, FAQS, APP_URL } from '../constants'
---

<BaseLayout
  title="Pricing"
  description="Simple, transparent pricing for Start POS. Trial, Basic, Premium, Enterprise, and Perpetual License plans. Free 1-month trial on all plans."
>

  <!-- Hero -->
  <section class="bg-slate-900 pt-16 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.04)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-1.5 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold px-4 py-1.5 rounded-full mb-6">
        🎁 All plans start with a free 1-month trial
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-white mb-4">Simple, transparent pricing</h1>
      <p class="text-lg text-slate-400 max-w-xl mx-auto">
        Pick the plan that fits your business today. Upgrade or downgrade anytime — no lock-in.
      </p>

      <!-- Billing toggle -->
      <div class="flex items-center justify-center gap-3 mt-8">
        <button id="toggle-monthly" class="billing-btn active-billing px-4 py-2 text-sm font-semibold rounded-lg bg-white text-slate-900 shadow-sm">Monthly</button>
        <button id="toggle-annual" class="billing-btn px-4 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-white transition-colors">
          Annual
          <span class="ml-1.5 bg-emerald-500 text-white text-xs px-1.5 py-0.5 rounded-full">Save 20%</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Plan cards -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-5" id="plan-grid">
        {PLANS.map((plan) => (
          <div class="plan-card-wrapper">
            <PlanCard plan={plan} annual={false} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Feature comparison table -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-black text-slate-900 mb-8 text-center">Full feature comparison</h2>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th class="text-left px-6 py-4 font-semibold text-slate-700 w-56">Feature</th>
              {['Trial', 'Basic', 'Premium', 'Enterprise', 'Perpetual'].map((name) => (
                <th class="text-center px-4 py-4 font-semibold text-slate-700">{name}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {[
              ['Price', 'Free (1mo)', '₱299/mo', '₱799/mo', '₱1,999/mo', 'One-time'],
              ['Transactions / mo', '500', '1,000', '5,000', '10,000', 'Unlimited'],
              ['Branches', '1', '1', '3', '5', 'Unlimited'],
              ['Employees', '1', '1', 'Unlimited', 'Unlimited', 'Unlimited'],
              ['POS Checkout', '✓', '✓', '✓', '✓', '✓'],
              ['Product Catalogue & Variants', '✓', '✓', '✓', '✓', '✓'],
              ['Customer Directory', '✓', '✓', '✓', '✓', '✓'],
              ['Receipt Printing', '✓', '✓', '✓', '✓', '✓'],
              ['Transaction History', '✓', '✓', '✓', '✓', '✓'],
              ['Order History', '✓', '✓', '✓', '✓', '✓'],
              ['Kitchen Workflow', '✓', '✓', '✓', '✓', '✓'],
              ['Cash Reconciliation', '—', '—', '✓', '✓', '✓'],
              ['Inventory Adjustments', '—', '—', '✓', '✓', '✓'],
              ['Inventory Transfers', '—', '—', '✓', '✓', '✓'],
              ['Sales Reports', '—', '—', '✓', '✓', '✓'],
              ['Inventory Reports', '—', '—', '✓', '✓', '✓'],
              ['CSV Export', '—', '—', '✓', '✓', '✓'],
              ['Supplier Management', '—', '—', '—', '✓', '✓'],
              ['Purchase Orders', '—', '—', '—', '✓', '✓'],
              ['Task Management', '—', '—', '—', '✓', '✓'],
              ['BIR Compliance', '✓', '✓', '✓', '✓', '✓'],
              ['Offline Mode', '✓', '✓', '✓', '✓', '✓'],
              ['Priority Support', '—', '—', '—', '✓', '✓'],
              ['Self-Hosted Deployment', '—', '—', '—', '—', '✓'],
            ].map(([feature, ...vals]) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-3.5 font-medium text-slate-700">{feature}</td>
                {vals.map((val) => (
                  <td class="px-4 py-3.5 text-center">
                    {val === '✓' ? (
                      <span class="inline-flex justify-center">
                        <svg class="text-emerald-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                      </span>
                    ) : val === '—' ? (
                      <span class="text-slate-300">—</span>
                    ) : (
                      <span class="text-slate-600 text-xs font-medium">{val}</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Add-ons -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h2 class="text-2xl font-black text-slate-900 mb-2">Add-ons</h2>
        <p class="text-slate-500 text-sm">Extend any plan with optional modules and capacity top-ups.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {ADDONS.map((addon) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:border-emerald-200 hover:shadow-md transition-all">
            <div class="flex items-start justify-between gap-3 mb-2">
              <h3 class="text-sm font-bold text-slate-900">{addon.name}</h3>
              <span class="text-sm font-bold text-emerald-600 whitespace-nowrap">{addon.price}</span>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">{addon.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-black text-slate-900 mb-2">Frequently asked questions</h2>
        <p class="text-slate-500 text-sm">Still have questions? <a href="/contact" class="text-emerald-600 hover:underline">Contact us</a>.</p>
      </div>
      <Accordion items={FAQS} />
    </div>
  </section>

  <FinalCTA />

</BaseLayout>

<script>
  const monthlyBtn = document.getElementById('toggle-monthly')
  const annualBtn = document.getElementById('toggle-annual')

  function setActive(btn: HTMLElement | null) {
    [monthlyBtn, annualBtn].forEach((b) => {
      b?.classList.remove('bg-white', 'text-slate-900', 'shadow-sm')
      b?.classList.add('text-slate-400')
    })
    btn?.classList.add('bg-white', 'text-slate-900', 'shadow-sm')
    btn?.classList.remove('text-slate-400')
  }

  monthlyBtn?.addEventListener('click', () => setActive(monthlyBtn))
  annualBtn?.addEventListener('click', () => setActive(annualBtn))
</script>
