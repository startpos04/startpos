---
import BaseLayout from '../layouts/BaseLayout.astro'
import FinalCTA from '../components/sections/FinalCTA.astro'
import { APP_URL } from '../constants'
import '../styles/print.css'
---

<BaseLayout
  title="Product Introduction — Start POS"
  description="Discover Start POS: A modern, offline-first, multi-tenant Point of Sale system designed for retail, restaurant, and grocery businesses."
>

  <!-- Print-Only Header -->
  <div class="print-only" style="display: none;">
    <div style="text-align: center; padding: 0.3rem 0; border-bottom: 2px solid #10b981; margin-bottom: 0.4rem;">
      <h1 style="font-size: 1.3rem; font-weight: 900; color: #0f172a; margin: 0; line-height: 1.2;">Start POS</h1>
      <p style="font-size: 0.8rem; color: #475569; margin: 0.1rem 0 0 0;">Product Introduction</p>
      <p style="font-size: 0.7rem; color: #64748b; margin: 0.1rem 0 0 0;">startpos.ph | hello@startpos.ph</p>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-emerald-900 pt-20 pb-28 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.06)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-white mb-6 leading-tight">
          Your Business.<br/>Your Rules.<br/><span class="text-emerald-400">Anywhere.</span>
        </h1>
        <p class="text-xl sm:text-2xl text-slate-300 mb-8 leading-relaxed">
          Transform how you run your business with <strong class="text-white">Start POS</strong> — 
          a next-generation Point of Sale system that works everywhere, for everyone.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={APP_URL} class="inline-flex items-center justify-center px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl shadow-lg transition-all hover:shadow-xl hover:scale-105">
            Start Free Trial
          </a>
          <a href="#overview" class="inline-flex items-center justify-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl backdrop-blur-sm transition-all border border-white/20">
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section id="overview" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Why Start POS?</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900 mb-4">
          Built for businesses that refuse to compromise
        </h2>
        <p class="text-lg text-slate-600">
          Whether you're running a bustling restaurant, a retail store, or a grocery operation, 
          Start POS adapts to your needs — not the other way around.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
          <div class="text-4xl mb-4">🌐</div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Work Anywhere, Anytime</h3>
          <p class="text-slate-600">
            Built with an offline-first architecture. Process sales, manage inventory, and serve customers 
            even when the internet doesn't cooperate. Everything syncs automatically when you're back online.
          </p>
        </div>

        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
          <div class="text-4xl mb-4">🎯</div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">One System, Every Business</h3>
          <p class="text-slate-600">
            Retail, Restaurant, or Grocery — our intelligent system adapts to your industry. 
            Full inventory management, kitchen workflows, and expiration tracking all in one platform.
          </p>
        </div>

        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
          <div class="text-4xl mb-4">📈</div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Scale With Confidence</h3>
          <p class="text-slate-600">
            Start with a single location and grow to multiple branches without switching systems. 
            Multi-tenant architecture with role-based access and branch-specific configurations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Business Types -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Suitable For</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900">
          Built for your industry
        </h2>
      </div>

      <div class="text-center">
        <div class="inline-flex flex-wrap justify-center gap-2 text-lg font-semibold text-slate-700">
          <span class="px-4 py-2 bg-white rounded-lg border border-slate-200">Retail</span>
          <span class="text-slate-400">·</span>
          <span class="px-4 py-2 bg-white rounded-lg border border-slate-200">Restaurants & Cafes</span>
          <span class="text-slate-400">·</span>
          <span class="px-4 py-2 bg-white rounded-lg border border-slate-200">Grocery</span>
          <span class="text-slate-400">·</span>
          <span class="px-4 py-2 bg-white rounded-lg border border-slate-200">Service Businesses</span>
          <span class="text-slate-400">·</span>
          <span class="px-4 py-2 bg-white rounded-lg border border-slate-200">Multi-Location Operations</span>
          <span class="text-slate-400">·</span>
          <span class="px-4 py-2 bg-white rounded-lg border border-slate-200">Mixed Operations</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Features Overview -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Features That Work</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900">
          Everything you need, nothing you don't
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <!-- Left Column -->
        <div class="space-y-6">
          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              <span class="inline-block w-6 h-6 bg-emerald-100 rounded text-emerald-600 text-sm text-center leading-6 mr-3">🛒</span>
              Intelligent Product Management
            </h3>
            <p class="text-slate-600 mb-3">
              Support for physical goods, services, raw materials, and bundles. Product variants, add-ons, 
              Bill of Materials (BOM), flexible pricing, and service duration management.
            </p>
            <div class="text-sm text-slate-500">
              Categories & SKUs · Multiple units · Cost & selling price tracking · Expiration tracking
            </div>
          </div>

          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              <span class="inline-block w-6 h-6 bg-violet-100 rounded text-violet-600 text-sm text-center leading-6 mr-3">📦</span>
              Complete Inventory Control
            </h3>
            <p class="text-slate-600 mb-3">
              Multi-location warehousing with batch tracking, expiration monitoring, stock adjustments, 
              internal transfers, and waste management.
            </p>
            <div class="text-sm text-slate-500">
              Branch-level stock · Low-stock alerts · Automatic refill tasks · Purchase receiving
            </div>
          </div>

          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              <span class="inline-block w-6 h-6 bg-blue-100 rounded text-blue-600 text-sm text-center leading-6 mr-3">💰</span>
              Powerful Sales Features
            </h3>
            <p class="text-slate-600 mb-3">
              Multiple payment methods, customer management, discounts, automatic tax computation, 
              receipt generation, and complete transaction history.
            </p>
            <div class="text-sm text-slate-500">
              Cash, card, e-wallet · Refunds & adjustments · Invoice numbering · PDF receipts
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class="space-y-6">
          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              <span class="inline-block w-6 h-6 bg-orange-100 rounded text-orange-600 text-sm text-center leading-6 mr-3">🍽️</span>
              Restaurant-Ready
            </h3>
            <p class="text-slate-600 mb-3">
              Kitchen order management, order status tracking, table/buzzer support, 
              dine-in/takeout/delivery modes, and customizable add-ons.
            </p>
            <div class="text-sm text-slate-500">
              Kitchen workflows · Order queue · Status tracking · Deposit management
            </div>
          </div>

          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              <span class="inline-block w-6 h-6 bg-pink-100 rounded text-pink-600 text-sm text-center leading-6 mr-3">💼</span>
              Financial Management
            </h3>
            <p class="text-slate-600 mb-3">
              Cash reconciliation, vendor session tracking, revenue and cost analysis, 
              profit calculations, and payment tracking across all methods.
            </p>
            <div class="text-sm text-slate-500">
              Vendor sessions · Revenue tracking · Cost analysis · Profit calculations
            </div>
          </div>

          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              <span class="inline-block w-6 h-6 bg-teal-100 rounded text-teal-600 text-sm text-center leading-6 mr-3">📋</span>
              Operational Excellence
            </h3>
            <p class="text-slate-600 mb-3">
              Built-in task management for shelf refills, purchase requests, branch transfers, 
              stock counting, and custom workflows with approval flow.
            </p>
            <div class="text-sm text-slate-500">
              Task workflows · Approval systems · Role assignments · Status tracking
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/features" class="inline-flex items-center gap-2 text-emerald-600 hover:text-emerald-700 font-semibold transition-colors">
          View all features in detail
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Configuration System -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Flexibility</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900 mb-4">
            Flexible Configuration
          </h2>
          <p class="text-lg text-slate-600">
            Start POS adapts to how your business operates, allowing business-wide settings 
            to be refined at branch and user level.
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white rounded-lg p-6 border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-4">BUSINESS</h3>
            <ul class="space-y-2 text-sm text-slate-600">
              <li>• Tax and business settings</li>
              <li>• Compliance settings</li>
              <li>• Business configuration</li>
            </ul>
          </div>
          
          <div class="bg-white rounded-lg p-6 border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-4">BRANCH</h3>
            <ul class="space-y-2 text-sm text-slate-600">
              <li>• Inventory settings</li>
              <li>• Pricing rules</li>
              <li>• Branch-specific controls</li>
            </ul>
          </div>
          
          <div class="bg-white rounded-lg p-6 border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-4">USER</h3>
            <ul class="space-y-2 text-sm text-slate-600">
              <li>• Roles and permissions</li>
              <li>• Personal preferences</li>
              <li>• User-level access</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Compliance -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl p-8 lg:p-12 text-white order-2 lg:order-1">
          <div class="text-4xl mb-4">🧾</div>
          <h3 class="text-2xl font-bold mb-4">Compliance Built-In</h3>
          <p class="text-slate-300 mb-6">
            Designed for global operations with built-in support for Philippines BIR requirements 
            and a framework ready for other Southeast Asian markets.
          </p>
          <ul class="space-y-3">
            {[
              'VAT, GST, and Sales Tax',
              'Multiple invoice types',
              'Tax categories & exemptions',
              'Compliance registry',
              'Sequential numbering',
              'Country-specific requirements',
            ].map((item) => (
              <li class="flex items-center gap-3">
                <svg class="shrink-0 text-emerald-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-slate-200">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="order-1 lg:order-2">
          <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Global Ready</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900 mb-4">
            Stay compliant, everywhere
          </h2>
          <p class="text-lg text-slate-600 mb-6">
            Tax regulations vary by country, but compliance shouldn't be complicated. 
            Start POS handles the complexity so you can focus on your business.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center text-emerald-600 font-bold text-sm">PH</div>
              <div>
                <div class="font-semibold text-slate-900">Philippines</div>
                <div class="text-sm text-slate-600">Full BIR compliance with PTU, VAT, and invoice numbering</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 font-bold text-sm">SG</div>
              <div>
                <div class="font-semibold text-slate-900">Singapore & Malaysia</div>
                <div class="text-sm text-slate-600">GST-ready architecture for regional expansion</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-8 h-8 bg-violet-100 rounded-lg flex items-center justify-center text-violet-600 font-bold text-sm">+</div>
              <div>
                <div class="font-semibold text-slate-900">More Countries</div>
                <div class="text-sm text-slate-600">Extensible framework for additional tax systems</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Built for Reliable Business Operations -->
  <section class="py-20 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Built For Reliability</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black mb-4">
          Built for reliable business operations
        </h2>
        <p class="text-lg text-slate-400 max-w-2xl mx-auto">
          Start POS is designed around reliability, security, flexibility, and efficient day-to-day business operations.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-slate-800 rounded-xl p-6 border border-slate-700">
          <div class="text-3xl mb-3">⚡</div>
          <h3 class="font-bold text-white mb-2">Offline-Capable Operations</h3>
          <p class="text-sm text-slate-400">Keep serving customers even when connectivity fails</p>
        </div>
        
        <div class="bg-slate-800 rounded-xl p-6 border border-slate-700">
          <div class="text-3xl mb-3">🔐</div>
          <h3 class="font-bold text-white mb-2">Secure Business Data</h3>
          <p class="text-sm text-slate-400">Enterprise-grade security with role-based access</p>
        </div>
        
        <div class="bg-slate-800 rounded-xl p-6 border border-slate-700">
          <div class="text-3xl mb-3">🏢</div>
          <h3 class="font-bold text-white mb-2">Multi-Branch Support</h3>
          <p class="text-sm text-slate-400">Scale from single location to multiple branches seamlessly</p>
        </div>
        
        <div class="bg-slate-800 rounded-xl p-6 border border-slate-700">
          <div class="text-3xl mb-3">🔄</div>
          <h3 class="font-bold text-white mb-2">Automatic Synchronization</h3>
          <p class="text-sm text-slate-400">Data syncs automatically when connection is restored</p>
        </div>
        
        <div class="bg-slate-800 rounded-xl p-6 border border-slate-700">
          <div class="text-3xl mb-3">💾</div>
          <h3 class="font-bold text-white mb-2">Reliable Transaction Processing</h3>
          <p class="text-sm text-slate-400">Every transaction is captured and processed reliably</p>
        </div>
        
        <div class="bg-slate-800 rounded-xl p-6 border border-slate-700">
          <div class="text-3xl mb-3">👥</div>
          <h3 class="font-bold text-white mb-2">Role-Based Access</h3>
          <p class="text-sm text-slate-400">Control what each team member can see and do</p>
        </div>
        
        <div class="bg-slate-800 rounded-xl p-6 border border-slate-700">
          <div class="text-3xl mb-3">📱</div>
          <h3 class="font-bold text-white mb-2">Cross-Platform Ready</h3>
          <p class="text-sm text-slate-400">Works seamlessly on desktop, tablet, and mobile</p>
        </div>
        
        <div class="bg-slate-800 rounded-xl p-6 border border-slate-700">
          <div class="text-3xl mb-3">🚀</div>
          <h3 class="font-bold text-white mb-2">Continuous Product Improvements</h3>
          <p class="text-sm text-slate-400">Regular updates and new features based on user feedback</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Next -->
  <section class="py-20 bg-gradient-to-br from-emerald-50 to-blue-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Roadmap</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900 mb-4">
          What's next?
        </h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          We're constantly evolving Start POS based on real business needs and customer feedback.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 border border-slate-200">
          <div class="text-3xl mb-3">☁️</div>
          <h3 class="font-bold text-slate-900 mb-2">Cloud Synchronization</h3>
          <p class="text-sm text-slate-600">Multi-device access with real-time sync</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-slate-200">
          <div class="text-3xl mb-3">📱</div>
          <h3 class="font-bold text-slate-900 mb-2">Barcode Scanner Integration</h3>
          <p class="text-sm text-slate-600">Native barcode scanning for inventory</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-slate-200">
          <div class="text-3xl mb-3">🎨</div>
          <h3 class="font-bold text-slate-900 mb-2">Receipt Designer</h3>
          <p class="text-sm text-slate-600">Custom receipt templates and branding</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-slate-200">
          <div class="text-3xl mb-3">📺</div>
          <h3 class="font-bold text-slate-900 mb-2">Kitchen Display System</h3>
          <p class="text-sm text-slate-600">Dedicated displays for restaurant workflows</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-slate-200">
          <div class="text-3xl mb-3">⭐</div>
          <h3 class="font-bold text-slate-900 mb-2">Customer Loyalty Programs</h3>
          <p class="text-sm text-slate-600">Points, rewards, and membership systems</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-slate-200">
          <div class="text-3xl mb-3">📊</div>
          <h3 class="font-bold text-slate-900 mb-2">Advanced Analytics</h3>
          <p class="text-sm text-slate-600">Business intelligence and forecasting</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Early Customer Program -->
  <section class="py-20 bg-gradient-to-br from-slate-900 via-slate-800 to-emerald-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Join Us Early</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-white mb-4">
          Join us at the beginning
        </h2>
        <p class="text-xl text-slate-300 max-w-3xl mx-auto">
          Start POS is entering its early customer stage, and we're inviting a select group of businesses 
          to be part of the journey. Join us early and receive exclusive benefits while helping shape 
          a POS platform built around the real needs of growing businesses.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-8 border border-white/10">
          <h3 class="text-xl font-bold text-white mb-6">Early Customer Benefits</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="shrink-0 w-6 h-6 bg-emerald-500 rounded-full flex items-center justify-center mt-0.5">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-white">Exclusive Introductory Pricing</div>
                <div class="text-sm text-slate-300">Special rates locked in for early adopters</div>
              </div>
            </li>
            
            <li class="flex items-start gap-3">
              <div class="shrink-0 w-6 h-6 bg-emerald-500 rounded-full flex items-center justify-center mt-0.5">
