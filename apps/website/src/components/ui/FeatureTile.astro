---
export interface Props {
  icon: string
  title: string
  description: string
  plan?: string
  class?: string
}

const { icon, title, description, plan, class: className = '' } = Astro.props
---

<div class:list={[
  'group flex flex-col gap-3 p-6 bg-white rounded-2xl border border-slate-200 hover:border-emerald-200 hover:shadow-lg hover:shadow-emerald-500/5 transition-all duration-200',
  className
]}>
  <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-xl group-hover:bg-emerald-100 transition-colors">
    {icon}
  </div>
  <div>
    <h3 class="text-base font-semibold text-slate-900 mb-1">{title}</h3>
    <p class="text-sm text-slate-500 leading-relaxed">{description}</p>
  </div>
  {plan && (
    <div class="mt-auto pt-2">
      <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">{plan}</span>
    </div>
  )}
</div>
