---
export interface Props {
  variant?: 'emerald' | 'violet' | 'blue' | 'slate' | 'amber' | 'rose'
  class?: string
}

const { variant = 'emerald', class: className = '' } = Astro.props

const variantClass = {
  emerald: 'bg-emerald-100 text-emerald-700',
  violet: 'bg-violet-100 text-violet-700',
  blue: 'bg-blue-100 text-blue-700',
  slate: 'bg-slate-100 text-slate-600',
  amber: 'bg-amber-100 text-amber-700',
  rose: 'bg-rose-100 text-rose-700',
}[variant]
---

<span class:list={['inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold', variantClass, className]}>
  <slot />
</span>
