---
import { APP_URL } from '../../constants'

// Get the base path from Astro config
const basePath = import.meta.env.BASE_URL || '/'
---

<footer class="bg-slate-900 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">

      <!-- Brand col -->
      <div class="lg:col-span-2 space-y-4">
        <a href={basePath} class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <span class="text-lg font-bold text-white tracking-tight">start<span class="text-emerald-400">POS</span></span>
        </a>
        <p class="text-sm text-slate-400 max-w-xs leading-relaxed">
          A modern, offline-first point of sale for retail, restaurant, and grocery. Built for businesses in the Philippines and Southeast Asia.
        </p>
        <a
          href={APP_URL}
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-emerald-500 rounded-lg hover:bg-emerald-600 transition-colors"
        >
          Start free trial
        </a>
      </div>

      <!-- Product links -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Product</h3>
        <ul class="space-y-2">
          <li><a href={basePath + 'product-intro'} class="text-sm hover:text-white transition-colors">Product Introduction</a></li>
          <li><a href={basePath + 'features'} class="text-sm hover:text-white transition-colors">Features</a></li>
          <li><a href={basePath + 'pricing'} class="text-sm hover:text-white transition-colors">Pricing</a></li>
          <li><a href={APP_URL} class="text-sm hover:text-white transition-colors">Start free trial</a></li>
        </ul>
      </div>

      <!-- Use cases -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Use Cases</h3>
        <ul class="space-y-2">
          <li><a href={basePath + 'use-cases/retail'} class="text-sm hover:text-white transition-colors">Retail</a></li>
          <li><a href={basePath + 'use-cases/restaurant'} class="text-sm hover:text-white transition-colors">Restaurant</a></li>
          <li><a href={basePath + 'use-cases/grocery'} class="text-sm hover:text-white transition-colors">Grocery</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Company</h3>
        <ul class="space-y-2">
          <li><a href={basePath + 'about'} class="text-sm hover:text-white transition-colors">About</a></li>
          <li><a href={basePath + 'contact'} class="text-sm hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} startPOS. All rights reserved. Built in the Philippines 🇵🇭</p>
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          BIR-compliant
        </span>
        <span>·</span>
        <span>Offline-first</span>
        <span>·</span>
        <span>Multi-branch ready</span>
      </div>
    </div>
  </div>
</footer>
