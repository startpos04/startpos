---
---

<section class="py-20 sm:py-24 bg-slate-900 overflow-hidden relative">
  <!-- Subtle grid -->
  <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.03)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-emerald-500/5 rounded-full blur-3xl"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

      <!-- Text -->
      <div class="reveal">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Offline-first architecture</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-white leading-tight">
          Checkout never stops.<br />Even without internet.
        </h2>
        <p class="mt-4 text-slate-400 text-base leading-relaxed">
          Unlike cloud-only POS systems, Start POS stores your data locally first.
          Your cashiers keep selling, your kitchen keeps cooking, and everything syncs
          automatically the moment you're back online. No data loss. No interruptions.
        </p>

        <ul class="mt-6 space-y-3">
          {[
            'Data stored on the device — available instantly',
            'Checkout works during full network outage',
            'Automatic background sync when connectivity returns',
            'Optimistic UI updates — no waiting spinners',
            'Conflict resolution built in',
          ].map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-slate-300">
              <svg class="mt-0.5 shrink-0 text-emerald-400" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Diagram -->
      <div class="reveal reveal-delay-2">
        <div class="bg-slate-800/60 border border-slate-700 rounded-2xl p-8">
          <!-- Sync diagram -->
          <div class="flex flex-col items-center gap-4">

            <!-- Device -->
            <div class="flex flex-col items-center gap-2">
              <div class="w-16 h-16 bg-slate-700 rounded-2xl border border-slate-600 flex items-center justify-center shadow-inner">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                  <line x1="12" y1="18" x2="12.01" y2="18"/>
                </svg>
              </div>
              <span class="text-xs font-semibold text-slate-300">Device</span>
            </div>

            <!-- Arrow down — always active -->
            <div class="flex flex-col items-center gap-1">
              <div class="flex items-center gap-3">
                <div class="h-12 w-px bg-gradient-to-b from-emerald-500 to-emerald-500/20 relative">
                  <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="#10b981" stroke="#10b981" stroke-width="0">
                      <polygon points="12 2 22 20 2 20"/>
                    </svg>
                  </div>
                </div>
              </div>
              <span class="text-xs text-emerald-400 font-semibold">Local DB</span>
              <span class="text-xs text-slate-500">Always available</span>
            </div>

            <!-- Online / Offline toggle visual -->
            <div class="w-full bg-slate-700/50 rounded-xl p-4 text-center border border-slate-600">
              <div class="flex justify-between items-center">
                <div class="flex flex-col items-center gap-1">
                  <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
                      <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
                      <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
                      <line x1="12" y1="20" x2="12.01" y2="20"/>
                    </svg>
                  </div>
                  <span class="text-xs text-slate-400">Online</span>
                  <span class="text-xs text-emerald-400 font-semibold">Syncing ✓</span>
                </div>

                <div class="text-slate-600 text-lg font-bold">↔</div>

                <div class="flex flex-col items-center gap-1">
                  <div class="w-10 h-10 rounded-xl bg-slate-600/50 border border-slate-500/30 flex items-center justify-center">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="1" y1="1" x2="23" y2="23"/>
                      <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/>
                      <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/>
                      <path d="M10.71 5.05A16 16 0 0 1 22.56 9"/>
                      <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/>
                      <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
                      <line x1="12" y1="20" x2="12.01" y2="20"/>
                    </svg>
                  </div>
                  <span class="text-xs text-slate-400">Offline</span>
                  <span class="text-xs text-slate-400 font-semibold">Still working</span>
                </div>
              </div>
            </div>

            <!-- Cloud -->
            <div class="flex flex-col items-center gap-2">
              <span class="text-xs text-slate-500">Syncs when back online ↓</span>
              <div class="w-16 h-16 bg-slate-700 rounded-2xl border border-slate-600 flex items-center justify-center shadow-inner">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
                </svg>
              </div>
              <span class="text-xs font-semibold text-slate-400">Cloud</span>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
