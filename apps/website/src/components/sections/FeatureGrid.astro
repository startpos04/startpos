---
import FeatureTile from '../ui/FeatureTile.astro'

const features = [
  {
    icon: '🛒',
    title: 'Point of Sale',
    description: 'Fast checkout with multiple payment methods — cash, card, e-wallet. Discounts, refunds, and tax handling built in.',
  },
  {
    icon: '📦',
    title: 'Inventory Management',
    description: 'Track stock across locations with batch tracking and expiry dates. Low-stock alerts keep shelves full.',
  },
  {
    icon: '📋',
    title: 'Orders & Kitchen Flow',
    description: 'Restaurant orders, kitchen status, dine-in, take-out, delivery. Everything in one queue.',
  },
  {
    icon: '📊',
    title: 'Reports & Analytics',
    description: 'Sales trends, inventory valuation, profit calculations, and CSV export for your accountant.',
  },
  {
    icon: '🏢',
    title: 'Multi-Branch',
    description: 'One account, multiple locations. Centralized control with branch-level permissions.',
  },
  {
    icon: '🔌',
    title: 'Works Offline',
    description: 'Local-first architecture. Checkout never stops. Syncs automatically when you\'re back online.',
  },
]
---

<section class="py-20 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 reveal">
      <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Features</span>
      <h2 class="mt-2 text-3xl sm:text-4xl font-black text-slate-900 leading-tight">
        Everything you need to run the business
      </h2>
      <p class="mt-3 text-slate-500 text-base">
        Start POS is a complete operations platform — not just a cash register.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f, i) => (
        <div class={`reveal reveal-delay-${(i % 3) + 1}`}>
          <FeatureTile icon={f.icon} title={f.title} description={f.description} />
        </div>
      ))}
    </div>

    <!-- Link to full features -->
    <div class="text-center mt-10 reveal">
      <a
        href="/features"
        class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors"
      >
        See all features
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>
