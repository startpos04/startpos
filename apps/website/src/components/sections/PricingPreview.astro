---
import { PLANS, APP_URL } from '../../constants'

const previewPlans = PLANS.filter(p => ['Basic', 'Premium', 'Enterprise'].includes(p.name))
---

<section class="py-20 sm:py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 reveal">
      <span class="inline-flex items-center gap-1.5 bg-emerald-100 text-emerald-700 text-xs font-bold px-3 py-1 rounded-full mb-3">
        🎁 All plans start with a free 30-day trial
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 leading-tight">
        Simple, transparent pricing
      </h2>
      <p class="mt-3 text-slate-500 text-base">
        Pick the plan that fits your business. Upgrade or downgrade anytime.
      </p>
    </div>

    <!-- Plan cards preview -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {previewPlans.map((plan) => (
        <div class:list={[
          'relative rounded-2xl border p-8 flex flex-col reveal',
          plan.highlighted
            ? 'border-emerald-400 bg-white shadow-xl shadow-emerald-500/10 ring-1 ring-emerald-400/20'
            : 'border-slate-200 bg-white hover:border-emerald-200 hover:shadow-md transition-all'
        ]}>
          {plan.badge && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="bg-emerald-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                {plan.badge}
              </span>
            </div>
          )}

          <h3 class="text-xl font-bold text-slate-900 mb-1">{plan.name}</h3>
          <p class="text-sm text-slate-500 mb-5">{plan.tagline}</p>

          <div class="mb-5">
            <span class="text-4xl font-black text-slate-900">₱{plan.price?.toLocaleString('en-PH')}</span>
            <span class="text-slate-400 text-sm">/mo</span>
          </div>

          <ul class="space-y-2.5 flex-grow mb-6">
            {plan.features.slice(0, 5).map((f) => (
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="mt-0.5 shrink-0 text-emerald-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <a
            href={APP_URL}
            class:list={[
              'block text-center px-5 py-2.5 rounded-xl text-sm font-semibold transition-all',
              plan.highlighted
                ? 'bg-emerald-500 text-white hover:bg-emerald-600 shadow-md'
                : 'bg-slate-900 text-white hover:bg-slate-700'
            ]}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>

    <!-- View full pricing -->
    <div class="text-center mt-10 reveal">
      <a
        href="/pricing"
        class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors"
      >
        See full pricing comparison
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>
