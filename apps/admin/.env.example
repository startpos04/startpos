# =============================================================================
# APP-SPECIFIC ENVIRONMENT — apps/admin
# Committed to git. Shared vars (POSTGRES_*) come from web/.env.
# =============================================================================

BUILD_ID=
CONSOLE_LOG=true

# --- App ---
HOST=0.0.0.0
PORT=3001
PUBLIC_PORT=3001
ADMIN_PORT=3001
ADMIN_PUBLIC_PORT=3201
NODE_ENV=development
DOCKER_DEV=false

CANONICAL_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_INTERNAL_URL=http://localhost:3001
BETTER_AUTH_SECRET=change-me

LOCAL_DB_NAME=admin_storage

# --- Feature Flags ---
ENABLE_EMAIL_VERIFICATION=false

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
