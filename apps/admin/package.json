{
  "name": "@startpos/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001 --host 0.0.0.0",
    "dev:docker": "vite dev --port 3001 --host 0.0.0.0 --strictPort",
    "build": "pnpm run generate && vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production pnpm run build && pnpm run preview",
    "generate": "pnpm exec prisma generate --schema=../../packages/platform/prisma/schema.prisma",
    "type-check": "pnpm exec tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:all": "pnpm coverage && pnpm coverage:integration",
    "type-coverage": "type-coverage --detail --at-least 95",
    "validate": "pnpm type-check && pnpm type-coverage && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.8.0",
    "@serwist/window": "^9.5.7",
    "@startpos/platform": "workspace:*",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.91.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/react-store": "^0.9.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.20",
    "lucide-react": "^0.564.0",
    "neverthrow": "^8.2.0",
    "next-themes": "^0.4.6",
    "pg": "8.18.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^3.8.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@prisma/internals": "^7.6.0",
    "@serwist/build": "^9.5.7",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.2.0",
    "@types/pg": "8.11.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^27.0.0",
    "nitro": "latest",
    "serwist": "^9.5.7",
    "tsx": "^4.21.0",
    "type-coverage": "^2.30.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.5"
  }
}
